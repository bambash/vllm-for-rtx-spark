+@triton.jit
+def _sigmoid(x):
+    exp = tl.inline_asm_elementwise(
+        "ex2.approx.f32 $0, $1;",
+        constraints="=f,f",
+        args=[-x * 1.4426950408889634],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    return tl.inline_asm_elementwise(
+        "rcp.approx.f32 $0, $1;",
+        constraints="=f,f",
+        args=[exp + 1.0],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+
