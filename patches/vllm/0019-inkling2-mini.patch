     return f'{{"name":{name_json},"args":{_canonical_json(args)}}}'
+
+
+# ── Inkling2 ──────────────────────────────────────────────────────────────
+#
+# Inkling2 keeps Inkling's block format but its reference renderer differs:
+# no generation prefix (the model emits its own ``<|message_model|>``), empty
+# string contents kept as empty blocks, effort quantized to integer
+# milli-effort, and its own canonical JSON spelling for floats.
+
+
+def render_inkling2_messages(
+    messages: Sequence[Mapping[str, Any]],
+    tokenizer: InklingTextTokenizer,
+    *,
+    tools: Sequence[Mapping[str, Any]] | None = None,
+    tool_choice: Any = None,
+    parallel_tool_calls: bool = True,
+    reasoning_effort: float = DEFAULT_REASONING_EFFORT,
+    continue_final_message: bool = False,
+) -> list[int]:
+    """Render chat messages to Inkling2 input ids.
+
+    With `continue_final_message`, a final assistant message holding only
+    a text string is left open so generation continues its text.
+    """
+    messages = list(messages)
+    assistant_prefix = None
+    if continue_final_message and messages:
+        assistant_prefix = continuation_prefix(messages[-1])
+        if assistant_prefix is not None:
+            messages.pop()
+
+    input_ids: list[int] = []
+    choice = _inkling2_tool_choice(tool_choice)
+    declared_tools = _collect_tools(messages, None if choice == "none" else tools)
+    if isinstance(choice, _NamedToolChoice):
+        declared_tools = [
+            tool
+            for tool in declared_tools
+            if _as_mapping(_as_mapping(tool).get("function", {})).get("name")
+            == choice.name
+        ]
+    if declared_tools:
+        _append_message(
+            input_ids,
+            tokenizer,
+            "system",
+            "xml",
+            _inkling2_tool_declare_json(declared_tools),
+            author_name="tool_declare",
+        )
+
+    effort_text: str | None = _inkling2_effort_text(reasoning_effort)
+    instruction = (
+        _inkling2_tool_choice_instruction(choice, parallel_tool_calls)
+        if declared_tools
+        else None
+    )
+    if instruction is not None:
+        if messages and messages[0].get("role") in {"system", "developer"}:
+            messages[0] = _with_appended_text(messages[0], instruction)
+        else:
+            effort_text = f"{effort_text}\n\n{instruction}"
+
+    tool_call_id_to_name: dict[str, str] = {}
+    for message in messages:
+        role = _expect_role(message)
+        if effort_text is not None and role not in {"system", "developer"}:
+            _append_message(input_ids, tokenizer, "system", "text", effort_text)
+            effort_text = None
+
+        author_name = None
+        if role == "tool":
+            name = message.get("name")
+            author_name = (
+                str(name)
+                if name
+                else tool_call_id_to_name.get(str(message.get("tool_call_id") or ""))
+            )
+        blocks = _inkling2_blocks(message, role, tool_call_id_to_name)
+        for kind, text, block_author in blocks:
+            _append_message(
+                input_ids,
+                tokenizer,
+                role,
+                kind,
+                text,
+                author_name=block_author or author_name,
+            )
+        if role == "assistant" and blocks:
+            input_ids.append(tokenizer.encode_special(CONTENT_MODEL_END_SAMPLING))
+
+    if effort_text is not None:
+        _append_message(input_ids, tokenizer, "system", "text", effort_text)
+
+    if assistant_prefix is not None:
+        input_ids.append(tokenizer.encode_special(MESSAGE_MODEL))
+        input_ids.append(tokenizer.encode_special(CONTENT_TEXT))
+        input_ids.extend(tokenizer.encode_text(assistant_prefix))
+    return input_ids
+
+
+def _assistant_reasoning(message: Mapping[str, Any]) -> Any:
+    reasoning = message.get("reasoning")
+    return message.get("reasoning_content") if reasoning is None else reasoning
+
+
+def continuation_prefix(message: Mapping[str, Any]) -> str | None:
+    """Return the text an Inkling2 `continue_final_message` request extends.
+
+    Only a plain-string assistant message with no tool calls or reasoning is
+    continued; `None` means the message renders as a closed turn.
+    """
+    content = message.get("content")
+    if (
+        message.get("role") != "assistant"
+        or not isinstance(content, str)
+        or message.get("tool_calls")
+        or _assistant_reasoning(message)
+    ):
+        return None
+    return content
+
+
+def _inkling2_blocks(
+    message: Mapping[str, Any],
+    role: str,
+    tool_call_id_to_name: dict[str, str],
+) -> list[tuple[str, str, str | None]]:
+    content = message.get("content")
+    if role != "assistant":
+        return [(kind, text, None) for kind, text in _iter_inkling2_parts(content)]
+
+    reasoning = _assistant_reasoning(message)
+    if reasoning is not None and not isinstance(reasoning, str):
+        raise TypeError("assistant reasoning_content must be a string")
+    tool_calls = message.get("tool_calls") or []
+    if content == "" and (tool_calls or reasoning):
+        content = None
+
+    blocks: list[tuple[str, str, str | None]] = (
+        [("thinking", reasoning, None)] if reasoning else []
+    )
+    blocks.extend((kind, text, None) for kind, text in _iter_inkling2_parts(content))
+    for tool_call in tool_calls:
+        name, args = _tool_call_name_and_args(tool_call)
+        tool_call_id = _as_mapping(tool_call).get("id")
+        if tool_call_id:
+            tool_call_id_to_name[str(tool_call_id)] = name
+        args = _tml_json_loads(json.dumps(args, allow_nan=False))
+        args_json = _tml_json_dumps(
+            {key: args[key] for key in sorted(args)}, sort_keys=False
+        )
+        blocks.append(
+            (
+                "invoke_tool_json",
+                f'{{"name":{_tml_json_dumps(name)},"args":{args_json}}}',
+                name,
+            )
+        )
+    return blocks
+
+
+@dataclass(frozen=True)
+class _NamedToolChoice:
+    name: str
+
+
+def _inkling2_tool_choice(tool_choice: Any) -> str | _NamedToolChoice:
+    if tool_choice is None:
+        return "auto"
+    if isinstance(tool_choice, str):
+        return tool_choice
+    choice = _as_mapping(tool_choice)
+    if choice.get("type") != "function":
+        raise ValueError(f"unsupported tool_choice: {tool_choice!r}")
+    function = choice.get("function")
+    return _NamedToolChoice(
+        _as_mapping(function)["name"] if function else choice["name"]
+    )
+
+
+def _inkling2_tool_choice_instruction(
+    choice: str | _NamedToolChoice, parallel_tool_calls: bool
+) -> str | None:
+    if isinstance(choice, _NamedToolChoice):
+        once = "" if parallel_tool_calls else " exactly once"
+        return (
+            f"Call the function named {json.dumps(choice.name)}{once} "
+            "in your next response."
+        )
+    if choice == "required":
+        quantity = "at least one" if parallel_tool_calls else "exactly one"
+        return f"Call {quantity} of the provided functions in your next response."
+    if choice == "auto" and not parallel_tool_calls:
+        return (
+            "If you call a function, call at most one function in your next response."
+        )
+    return None
+
+
+def _with_appended_text(message: Mapping[str, Any], text: str) -> dict[str, Any]:
+    content = message.get("content")
+    if isinstance(content, str) and content:
+        content = f"{content}\n\n{text}"
+    elif not content:
+        content = text
+    else:
+        content = [*content, {"type": "text", "text": text}]
+    return {**message, "content": content}
+
+
+def _iter_inkling2_parts(content: Any) -> Iterator[tuple[str, str]]:
+    if content is None:
+        return
+    if isinstance(content, str):
+        yield ("text", content)
+        return
+    if not isinstance(content, Sequence) or isinstance(content, (bytes, bytearray)):
+        raise TypeError("message content must be a string or a sequence of parts")
+    for part in content:
+        if isinstance(part, str):
+            yield ("text", part)
+            continue
+        if not isinstance(part, Mapping):
+            raise TypeError(f"content part must be mapping, got {type(part).__name__}")
+        ptype = part.get("type")
+        if ptype in (None, "text", "input_text"):
+            yield ("text", part.get("text") or "")
+        elif ptype == "thinking":
+            yield ("thinking", part.get("thinking") or "")
+        elif ptype == "tool_error":
+            yield ("tool_error", part.get("text") or "")
+        elif ptype in _IMAGE_PART_TYPES:
+            yield ("image", "")
+        else:
+            raise ValueError(f"unsupported Inkling2 content part type: {ptype!r}")
+
+
+def _inkling2_effort_text(reasoning_effort: float) -> str:
+    if not 0.0 <= reasoning_effort <= _MAX_REASONING_EFFORT:
+        raise ValueError(
+            f"Inkling reasoning_effort must be in [0.0, 0.99], got {reasoning_effort!r}"
+        )
+    millieffort = round(reasoning_effort * 1000)
+    effort = round((millieffort / 1000) * 100) / 100
+    return f"Thinking effort level: {effort:g}"
+
+
+def _inkling2_tool_declare_json(tools: Sequence[Mapping[str, Any]]) -> str:
+    tool_specs = []
+    for tool_value in tools:
+        tool = _as_mapping(tool_value)
+        function = {
+            key: value
+            for key, value in _as_mapping(tool.get("function", {})).items()
+            if value is not None
+        }
+        parameters = function.get("parameters", {})
+        if not isinstance(parameters, Mapping):
+            raise TypeError("tool parameters must be a JSON object")
+        tool_specs.append(
+            {
+                "description": function.get("description", ""),
+                "name": function["name"],
+                "parameters": _tml_json_loads(
+                    json.dumps(parameters, ensure_ascii=False, allow_nan=False)
+                ),
+                "type": tool.get("type") or "function",
+            }
+        )
+    return _tml_json_dumps(tool_specs, legacy_floats=False)
+
+
+def _tml_json_loads(text: str) -> Any:
+    """Parse JSON as the Inkling2 reference does (64-bit ints, finite floats)."""
+
+    def invalid_constant(value: str) -> Any:
+        raise ValueError(f"Invalid JSON constant: {value}")
+
+    def finite_float(value: str) -> float:
+        number = float(value)
+        if not math.isfinite(number):
+            raise ValueError("JSON number out of range")
+        return number
+
+    def bounded_int(value: str) -> int | float:
+        number = int(value)
+        if value == "-0" or not -(1 << 63) <= number < 1 << 64:
+            return finite_float(value)
+        return number
+
+    return json.loads(
+        text,
+        parse_constant=invalid_constant,
+        parse_float=finite_float,
+        parse_int=bounded_int,
+    )
+
+
+def _tml_json_dumps(
+    value: Any, *, legacy_floats: bool = True, sort_keys: bool = True
+) -> str:
+    """Compact JSON with the Inkling2 reference float spelling."""
+    if isinstance(value, Mapping):
+        if not all(isinstance(key, str) for key in value):
+            raise TypeError("JSON object keys must be strings")
+        return (
+            "{"
+            + ",".join(
+                _tml_json_dumps(key)
+                + ":"
+                + _tml_json_dumps(
+                    value[key], legacy_floats=legacy_floats, sort_keys=sort_keys
+                )
+                for key in (sorted(value) if sort_keys else value)
+            )
+            + "}"
+        )
+    if isinstance(value, (list, tuple)):
+        items = (
+            _tml_json_dumps(item, legacy_floats=legacy_floats, sort_keys=sort_keys)
+            for item in value
+        )
+        return "[" + ",".join(items) + "]"
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            raise ValueError("JSON numbers must be finite")
+        result = repr(value)
+        if "e" not in result:
+            return result
+        mantissa, exponent_text = result.split("e")
+        exponent = int(exponent_text)
+        if -5 <= exponent < 16:
+            negative = mantissa.startswith("-")
+            digits = mantissa.lstrip("-").replace(".", "")
+            decimal = exponent + 1
+            if decimal <= 0:
+                result = "0." + "0" * -decimal + digits
+            elif decimal >= len(digits):
+                result = digits + "0" * (decimal - len(digits)) + ".0"
+            else:
+                result = digits[:decimal] + "." + digits[decimal:]
+            return ("-" if negative else "") + result
+        sign = "+" if exponent >= 0 and not legacy_floats else ""
+        return mantissa + "e" + sign + str(exponent)
+    return json.dumps(value, ensure_ascii=False, separators=(",", ":"), allow_nan=False)
