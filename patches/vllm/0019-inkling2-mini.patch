index 0000000..b50a072
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/grouped_gemm.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""BF16 grouped GEMM over expert-sorted rows (the expert LoRA projections)."""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _grouped_gemm_kernel(
+    X,
+    W,
+    Y,
+    Perm,
+    Offsets,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    NUM_EXPERTS: tl.constexpr,
+    EXPERTS_POW2: tl.constexpr,
+    TOPK: tl.constexpr,
+    GATHER: tl.constexpr,
+    ACCUMULATE: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+):
+    # Program (n tile, row block): the row block is found from the per-expert
+    # block counts, so the grid is a static upper bound and nothing is read
+    # back to the host (CUDA graph capture).
+    pid = tl.program_id(1)
+    experts = tl.arange(0, EXPERTS_POW2)
+    starts = tl.load(Offsets + experts, experts < NUM_EXPERTS, other=0)
+    ends = tl.load(Offsets + experts + 1, experts < NUM_EXPERTS, other=0)
+    blocks = tl.cumsum(tl.cdiv(ends - starts, BM), 0)
+    expert = tl.sum((blocks <= pid).to(tl.int32), 0)
+    if expert >= NUM_EXPERTS:
+        return
+    block = pid - tl.max(tl.where(blocks <= pid, blocks, 0), 0)
+    rows = (tl.load(Offsets + expert) + block * BM).to(tl.int64) + tl.arange(0, BM)
+    row_mask = rows < tl.load(Offsets + expert + 1)
+    x_rows = tl.load(Perm + rows, row_mask, other=0) // TOPK if GATHER else rows
+    cols = tl.program_id(0) * BN + tl.arange(0, BN)
+    col_mask = cols < N
+    ks = tl.arange(0, BK)
+    x_ptrs = X + x_rows[:, None] * K + ks[None, :]
+    w_ptrs = W + (expert.to(tl.int64) * N + cols[None, :]) * K + ks[:, None]
+    acc = tl.zeros((BM, BN), tl.float32)
+    for k in range(0, K, BK):
+        k_mask = (k + ks) < K
+        x = tl.load(x_ptrs, row_mask[:, None] & k_mask[None, :], other=0.0)
+        w = tl.load(w_ptrs, k_mask[:, None] & col_mask[None, :], other=0.0)
+        acc = tl.dot(x, w, acc)
+        x_ptrs += BK
+        w_ptrs += BK
+    y_ptrs = Y + rows[:, None] * N + cols[None, :]
+    mask = row_mask[:, None] & col_mask[None, :]
+    if ACCUMULATE:
+        acc += tl.load(y_ptrs, mask, other=0.0).to(tl.float32)
+    tl.store(y_ptrs, acc.to(Y.dtype.element_ty), mask)
+
+
+def grouped_gemm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    perm: torch.Tensor,
+    offsets: torch.Tensor,
+    num_rows: int,
+    topk: int,
+    gather: bool,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """`out[r] (+)= x[r] @ weight[e].T` for this rank's expert-sorted rows.
+
+    Same row contract as `ops.moe.expert_gemm`: rows `[offsets[0],
+    offsets[-1])` are this rank's, expert `e`'s rows are `[offsets[e],
+    offsets[e + 1])`; with `gather` row `r` reads `x[perm[r] // topk]`.
+    `weight` is BF16 `[E, N, K]`. Without `out`, returns a new
+    `[num_rows, N]` tensor whose rows outside this rank's range are
+    uninitialized; with `out`, adds into it (FP32 accumulation either way).
+    """
+    num_experts, n, k = weight.shape
+    accumulate = out is not None
+    if out is None:
+        out = x.new_empty(num_rows, n)
+    assert out.is_contiguous() and out.shape == (num_rows, n)
+    block_m, block_n, block_k = 64, min(128, max(16, triton.next_power_of_2(n))), 64
+    # Every non-empty expert holds at least one row.
+    max_blocks = triton.cdiv(num_rows, block_m) + min(num_experts, num_rows) - 1
+    if max_blocks > 0:
+        _grouped_gemm_kernel[(triton.cdiv(n, block_n), max_blocks)](
+            x,
+            weight,
+            out,
+            perm,
+            offsets,
+            n,
+            k,
+            num_experts,
+            triton.next_power_of_2(num_experts),
+            topk,
+            gather,
+            accumulate,
+            block_m,
+            block_n,
+            block_k,
+            num_warps=4,
+            num_stages=3,
+        )
+    return out
diff --git a/vllm/models/inkling2/nvidia/ops/linear.py b/vllm/models/inkling2/nvidia/ops/linear.py
new file mode 100644
index 0000000..dfbe722
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/linear.py
@@ -0,0 +1,291 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""bf16 linears: small batches on FlashInfer's CuTe DSL low-M kernels, and the
+reference `linear` with fp32 accumulation in ordered 1024-wide K groups."""
+
+import torch
+
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, triton
+from vllm.utils.flashinfer import is_flashinfer_autotuning
+
+from . import use_sm100_kernels
+from .ll_gemm_sm120 import sm12x_bf16_ll_gemm, use_sm12x_bf16_ll_gemm
+
+# Up to this many rows, FlashInfer's CuTe DSL low-M kernels run near HBM
+# bandwidth (cuBLAS is up to 2x slower); larger batches use cuBLAS.
+LOW_M_MAX_TOKENS = 32
+
+
+def linear(
+    x: torch.Tensor, weight: torch.Tensor, out: torch.Tensor | None = None
+) -> torch.Tensor:
+    """bf16 `x @ weight.T` with fp32 accumulation (into `out` if given,
+    batches over LOW_M_MAX_TOKENS only)."""
+    if out is not None:
+        assert x.shape[0] > LOW_M_MAX_TOKENS
+        return torch.mm(x, weight.t(), out=out)
+    if use_sm12x_bf16_ll_gemm(x, weight):
+        return sm12x_bf16_ll_gemm(x, weight)
+    # Autotuning would profile the CuTe DSL kernels past their 32-row limit.
+    if (
+        x.shape[0] > LOW_M_MAX_TOKENS
+        or is_flashinfer_autotuning()
+        or not use_sm100_kernels()
+    ):
+        return torch.nn.functional.linear(x, weight)
+    from flashinfer import mm_bf16
+
+    return mm_bf16(x, weight.t(), pdl=True, backend="cute-dsl")
+
+
+@triton.jit
+def _k_group_tile(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+    pid_n,
+    pid_m,
+    pid_k,
+):
+    # Row tiles of at most 64 keep tl.dot on the same mma.sync instruction
+    # sequence as the reference's 16x32x32 tiling. With SPLIT, each program computes one
+    # K group's partial; otherwise it sums the groups in order.
+    cols = pid_n * BN + tl.arange(0, BN)
+    rows = pid_m * BM + tl.arange(0, BM)
+    ks = tl.arange(0, 128)
+    first = pid_k if SPLIT else 0
+    NUM_GROUPS: tl.constexpr = 1 if SPLIT else (K + 1023) // 1024
+    total = tl.zeros((BM, BN), tl.float32)
+    for g in tl.static_range(NUM_GROUPS):
+        group = first + g
+        partial = tl.zeros((BM, BN), tl.float32)
+        for tile in range(tl.minimum(8, tl.cdiv(K - group * 1024, 128))):
+            k = group * 1024 + tile * 128 + ks
+            x = tl.load(
+                X + rows[:, None] * K + k[None, :],
+                (rows[:, None] < M) & (k[None, :] < K),
+                other=0,
+            )
+            w = tl.load(
+                W + cols[None, :] * K + k[:, None],
+                (cols[None, :] < N) & (k[:, None] < K),
+                other=0,
+            )
+            partial = tl.dot(x, w, partial)
+        if g > 0:
+            # Keep a short tail's dot separate from the preceding 1024-wide
+            # groups; folding total into its MMA changes the rounding order.
+            partial = tl.inline_asm_elementwise(
+                "mov.b32 $0, $1;",
+                "=f,f",
+                [partial],
+                dtype=tl.float32,
+                is_pure=True,
+                pack=1,
+            )
+        total = partial if g == 0 else total + partial
+    tl.store(
+        Y + (first * M + rows[:, None]) * N + cols[None, :],
+        total.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & (cols[None, :] < N),
+    )
+
+
+@triton.jit
+def _prefetch_k_group_tile(
+    W, N: tl.constexpr, K: tl.constexpr, BN: tl.constexpr, pid_n, pid_k
+):
+    # Pulls one K group's weight tile into L2, one 128-byte line per element.
+    cols = pid_n * BN + tl.arange(0, BN)
+    k = pid_k * 1024 + tl.arange(0, 16) * 64
+    mask = (cols[:, None] < N) & (k[None, :] < K)
+    tl.inline_asm_elementwise(
+        "{ .reg .pred p; setp.ne.b32 p, $2, 0; "
+        "@p prefetch.global.L2 [$1]; mov.b32 $0, 0; }",
+        "=r,l,r",
+        [W + cols[:, None] * K + k[None, :], mask.to(tl.int32)],
+        dtype=tl.int32,
+        is_pure=False,
+        pack=1,
+    )
+
+
+@triton.jit
+def _k_group_kernel(
+    X,
+    W,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    SPLIT: tl.constexpr,
+):
+    if SPLIT and tl.program_id(1) == 0:
+        _prefetch_k_group_tile(W, N, K, BN, tl.program_id(0), tl.program_id(2))
+    tl.extra.cuda.gdc_wait()
+    _k_group_tile(
+        X,
+        W,
+        Y,
+        M,
+        N,
+        K,
+        BM,
+        BN,
+        SPLIT,
+        tl.program_id(0),
+        tl.program_id(1),
+        tl.program_id(2),
+    )
+
+
+@triton.jit
+def _k_group_sum_kernel(Partials, Y, MN, GROUPS: tl.constexpr, BLOCK: tl.constexpr):
+    tl.extra.cuda.gdc_wait()
+    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    mask = offs < MN
+    total = tl.load(Partials + offs, mask)
+    for group in range(1, GROUPS):
+        total = total + tl.load(Partials + group * MN + offs, mask)
+    tl.store(Y + offs, total, mask)
+
+
+@triton.jit
+def _k_group_tma_kernel(
+    XDesc,
+    WDesc,
+    Y,
+    M,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    BM: tl.constexpr,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    LAUNCH_DEPENDENTS: tl.constexpr,
+):
+    # One output tile over all of K: each group's partial accumulates on the
+    # tensor cores and is added to the running sum in order.
+    TILES: tl.constexpr = (K + BK - 1) // BK
+    GROUP_TILES: tl.constexpr = 1024 // BK
+    rows = tl.program_id(1) * BM
+    cols = tl.program_id(0) * BN
+    tl.extra.cuda.gdc_wait()
+    if LAUNCH_DEPENDENTS:
+        tl.extra.cuda.gdc_launch_dependents()
+    total = tl.zeros((BM, BN), tl.float32)
+    partial = tl.zeros((BM, BN), tl.float32)
+    for tile in tl.range(TILES, warp_specialize=True):
+        x = XDesc.load([rows, tile * BK])
+        w = WDesc.load([cols, tile * BK])
+        partial = tl.dot(x, w.T, partial)
+        if tile % GROUP_TILES == GROUP_TILES - 1 or tile == TILES - 1:
+            total = total + partial
+            partial = tl.zeros((BM, BN), tl.float32)
+    r = rows + tl.arange(0, BM)[:, None]
+    c = cols + tl.arange(0, BN)[None, :]
+    tl.store(Y + r * N + c, total.to(Y.dtype.element_ty), (r < M) & (c < N))
+
+
+# From this many rows, 128-row TMA tiles over all of K fill the GPU.
+TMA_MIN_TOKENS = 2048
+
+
+def k_group_partials(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    out_dtype: torch.dtype = torch.float32,
+    launch_dependents: bool = False,
+) -> torch.Tensor:
+    """fp32 partials [G, T, N] of `x @ weight.T` whose in-order sum over G is
+    the reference `linear`. G is 1 (already summed, in `out_dtype`) when
+    there are enough rows to fill the GPU without splitting K. With
+    `launch_dependents`, the next kernel may start (and must wait) while
+    the TMA kernel runs."""
+    assert x.is_contiguous() and weight.is_contiguous()
+    tokens, hidden = x.shape
+    n = weight.shape[0]
+    sm120 = current_platform.is_device_capability_family(120)
+    if tokens >= TMA_MIN_TOKENS:
+        from triton.tools.tensor_descriptor import TensorDescriptor
+
+        out = torch.empty((1, tokens, n), dtype=out_dtype, device=x.device)
+        # SM12x allows ~99 KiB of shared memory per block: two 48 KiB stages fit.
+        block_n = 64 if tokens < 4096 or sm120 else 128
+        _k_group_tma_kernel[(triton.cdiv(n, block_n), triton.cdiv(tokens, 128))](
+            TensorDescriptor.from_tensor(x, [128, 128]),
+            TensorDescriptor.from_tensor(weight, [block_n, 128]),
+            out,
+            tokens,
+            n,
+            hidden,
+            128,
+            block_n,
+            128,
+            launch_dependents,
+            num_warps=4 if block_n == 64 else 8,
+            num_stages=2 if sm120 else 4 if block_n == 64 else 3,
+            enable_fp_fusion=False,
+            launch_pdl=True,
+        )
+        return out
+    block_m = 16 if tokens <= 128 else 64
+    block_n = 32 if tokens <= 16 else 64 if tokens <= 256 else 128
+    groups = triton.cdiv(hidden, 1024)
+    split = groups > 1 and tokens < 4096
+    num_warps = 4 if block_n <= 64 else 8
+    num_stages = 4 if not split else 3 if block_n <= 64 else 2
+    if sm120:
+        num_stages = min(num_stages, 2)
+    out = torch.empty(
+        (groups if split else 1, tokens, n),
+        dtype=torch.float32 if split else out_dtype,
+        device=x.device,
+    )
+    grid = (
+        triton.cdiv(n, block_n),
+        triton.cdiv(tokens, block_m),
+        groups if split else 1,
+    )
+    _k_group_kernel[grid](
+        x,
+        weight,
+        out,
+        tokens,
+        n,
+        hidden,
+        block_m,
+        block_n,
+        split,
+        num_warps=num_warps,
+        num_stages=num_stages,
+        enable_fp_fusion=False,
+        launch_pdl=True,
+    )
+    return out
+
+
+def linear_k_groups(
+    x: torch.Tensor, weight: torch.Tensor, out_dtype: torch.dtype = torch.float32
+) -> torch.Tensor:
+    """`x @ weight.T` for bf16 `x` [T, K] and `weight` [N, K].
+
+    Each 1024-wide K group is accumulated in fp32 and the partials are summed in
+    order, as in the reference `linear`.
+    """
+    partials = k_group_partials(x, weight, out_dtype)
+    if partials.shape[0] == 1:
+        return partials[0]
+    out = torch.empty(partials.shape[1:], dtype=out_dtype, device=x.device)
+    _k_group_sum_kernel[(triton.cdiv(out.numel(), 1024),)](
+        partials, out, out.numel(), partials.shape[0], 1024, launch_pdl=True
+    )
+    return out
diff --git a/vllm/models/inkling2/nvidia/ops/ll_gemm_sm120.py b/vllm/models/inkling2/nvidia/ops/ll_gemm_sm120.py
new file mode 100644
index 0000000..9c5fe9c
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/ll_gemm_sm120.py
@@ -0,0 +1,362 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Low-M BF16 tensor-core projections for SM120/SM121: batched `x @ w.T` with
+deterministic split-K for narrow outputs, and a grouped q/k/v projection."""
+
+import functools
+from typing import NamedTuple
+
+import torch
+
+from vllm.platforms import current_platform
+from vllm.triton_utils import tl, triton
+from vllm.utils.platform_utils import num_compute_units
+from vllm.utils.torch_utils import current_stream
+
+MAX_M = 16
+_MP = 16
+_MAX_TILES = 4096
+
+
+@triton.jit
+def _ll_gemm_kernel(
+    X,
+    W,
+    Bias,
+    Y,
+    P,
+    C,
+    M,
+    N,
+    K,
+    SXB,
+    SXM,
+    SWB,
+    SWN,
+    SYB,
+    SYM,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    K_PER_SPLIT: tl.constexpr,
+    SPLIT: tl.constexpr,
+    MP: tl.constexpr,
+):
+    """Program `(n, b, s)` computes column tile `n` of batch `b` over K range
+    `s`. With `SPLIT > 1` it writes fp32 partials to `P` `[SPLIT, B, MP, N]`;
+    the last of the tile's programs to finish (counted in `C`, reset to 0
+    after) sums them in split order, so results are deterministic."""
+    tl.extra.cuda.gdc_wait()
+    pid_n = tl.program_id(0)
+    b = tl.program_id(1)
+    s = tl.program_id(2)
+    rows = tl.arange(0, MP)
+    cols = pid_n * BN + tl.arange(0, BN)
+    ks = s * K_PER_SPLIT + tl.arange(0, BK)
+    x_ptrs = X + (b * SXB + rows[:, None] * SXM + ks[None, :])
+    w_ptrs = W + (b * SWB + cols[None, :] * SWN + ks[:, None])
+    acc = tl.zeros((MP, BN), tl.float32)
+    for _ in range(0, tl.minimum(K - s * K_PER_SPLIT, K_PER_SPLIT), BK):
+        # Issuing W's copies before X's measured faster.
+        w = tl.load(w_ptrs, (cols[None, :] < N) & (ks[:, None] < K), other=0)
+        x = tl.load(x_ptrs, (rows[:, None] < M) & (ks[None, :] < K), other=0)
+        acc += tl.dot(x, w)
+        x_ptrs += BK
+        w_ptrs += BK
+        ks += BK
+
+    is_last = True
+    if SPLIT > 1:
+        num_b = tl.num_programs(1)
+        tile = b * tl.num_programs(0) + pid_n
+        offs = rows[:, None] * N + cols[None, :]
+        mask = (rows[:, None] < M) & (cols < N)[None, :]
+        tl.store(P + ((s * num_b + b) * MP * N + offs), acc, mask)
+        tl.debug_barrier()
+        is_last = tl.atomic_add(C + tile, 1, sem="acq_rel", scope="gpu") == SPLIT - 1
+        if is_last:
+            acc = tl.zeros((MP, BN), tl.float32)
+            for i in tl.static_range(SPLIT):
+                acc += tl.load(
+                    P + ((i * num_b + b) * MP * N + offs),
+                    mask,
+                    cache_modifier=".cg",
+                )
+            tl.atomic_xchg(C + tile, 0, sem="relaxed", scope="gpu")
+    if is_last:
+        if Bias is not None:
+            acc += tl.load(Bias + cols, cols < N, other=0).to(tl.float32)[None, :]
+        tl.store(
+            Y + (b * SYB + rows[:, None] * SYM + cols[None, :]),
+            acc.to(Y.dtype.element_ty),
+            (rows[:, None] < M) & (cols[None, :] < N),
+        )
+    tl.extra.cuda.gdc_launch_dependents()
+
+
+@triton.jit
+def _segment_input(b, XQ, XK, XV, SXQ, SXK, SXV):
+    if b == 0:
+        x, stride = XQ, SXQ
+    elif b == 1:
+        x, stride = XK, SXK
+    else:
+        x, stride = XV, SXV
+    return x, stride
+
+
+@triton.jit
+def _qkv_bmm_kernel(
+    XQ,
+    XK,
+    XV,
+    W,
+    Y,
+    M,
+    N,
+    K,
+    S1,
+    S2,
+    SXQ,
+    SXK,
+    SXV,
+    SWN,
+    SYM,
+    BN: tl.constexpr,
+    BK: tl.constexpr,
+    MP: tl.constexpr,
+):
+    """Columns `[0, S1)` of `Y` are `XQ @ W.T`, `[S1, S2)` `XK` and `[S2, N)`
+    `XV`. A tile spanning a boundary runs both inputs' dots and picks per
+    column (the second input's loads hit L2)."""
+    tl.extra.cuda.gdc_wait()
+    n0 = tl.program_id(0) * BN
+    n1 = tl.minimum(n0 + BN, N) - 1
+    b_lo = (n0 >= S1).to(tl.int32) + (n0 >= S2).to(tl.int32)
+    b_hi = (n1 >= S1).to(tl.int32) + (n1 >= S2).to(tl.int32)
+    x_lo, sx_lo = _segment_input(b_lo, XQ, XK, XV, SXQ, SXK, SXV)
+    x_hi, sx_hi = _segment_input(b_hi, XQ, XK, XV, SXQ, SXK, SXV)
+    rows = tl.arange(0, MP)
+    cols = n0 + tl.arange(0, BN)
+    ks = tl.arange(0, BK)
+    x_lo += rows[:, None] * sx_lo + ks[None, :]
+    x_hi += rows[:, None] * sx_hi + ks[None, :]
+    w_ptrs = W + (cols[None, :] * SWN + ks[:, None])
+    acc_lo = tl.zeros((MP, BN), tl.float32)
+    acc_hi = tl.zeros((MP, BN), tl.float32)
+    for _ in range(0, K, BK):
+        x_mask = (rows[:, None] < M) & (ks[None, :] < K)
+        w = tl.load(w_ptrs, (cols[None, :] < N) & (ks[:, None] < K), other=0)
+        acc_lo += tl.dot(tl.load(x_lo, x_mask, other=0), w)
+        acc_hi += tl.dot(tl.load(x_hi, x_mask, other=0), w)
+        x_lo += BK
+        x_hi += BK
+        w_ptrs += BK
+        ks += BK
+    segment = (cols >= S1).to(tl.int32) + (cols >= S2).to(tl.int32)
+    acc = tl.where((segment == b_lo)[None, :], acc_lo, acc_hi)
+    tl.store(
+        Y + (rows[:, None] * SYM + cols[None, :]),
+        acc.to(Y.dtype.element_ty),
+        (rows[:, None] < M) & (cols[None, :] < N),
+    )
+    tl.extra.cuda.gdc_launch_dependents()
+
+
+class _Config(NamedTuple):
+    bn: int
+    bk: int
+    split: int
+    k_per_split: int
+    num_warps: int
+    num_stages: int
+
+
+@functools.cache
+def _config(nb: int, n: int, k: int) -> _Config:
+    """Split K into about one wave of programs when that gives at least 3
+    splits, preferring 16-column tiles; otherwise one 32-column tile over all
+    of K."""
+    num_sms = num_compute_units()
+    bk = min(128, max(16, triton.next_power_of_2(k)))
+    k_tiles = triton.cdiv(k, bk)
+    for bn in (16, 32):
+        split = min(32, k_tiles, num_sms // (nb * triton.cdiv(n, bn)))
+        if split >= 3:
+            tiles_per_split = triton.cdiv(k_tiles, split)
+            split = triton.cdiv(k_tiles, tiles_per_split)
+            return _Config(bn, bk, split, tiles_per_split * bk, 4, 4)
+    bk = min(256, max(16, triton.next_power_of_2(k)))
+    return _Config(32, bk, 1, triton.cdiv(k, bk) * bk, 4, 3)
+
+
+@functools.cache
+def _counter(stream: int) -> torch.Tensor:
+    """Split-K tile counters for one stream; each launch leaves them zeroed."""
+    return torch.zeros(_MAX_TILES, dtype=torch.int32, device="cuda")
+
+
+def _ll_gemm(
+    x: torch.Tensor, w: torch.Tensor, bias: torch.Tensor | None, out: torch.Tensor
+) -> None:
+    nb, m, k = x.shape
+    n = w.shape[1]
+    assert 0 < m <= MAX_M and w.shape == (nb, n, k)
+    assert x.stride(2) == w.stride(2) == 1
+    assert bias is None or (bias.shape == (n,) and bias.stride(0) == 1)
+    assert out.shape == (nb, m, n) and out.stride(2) == 1
+    assert max(nb * w.stride(0), nb * x.stride(0), nb * out.stride(0)) < 2**31
+    cfg = _config(nb, n, k)
+    n_tiles = triton.cdiv(n, cfg.bn)
+    partials = counter = None
+    if cfg.split > 1:
+        assert nb * n_tiles <= _MAX_TILES
+        partials = torch.empty(
+            (cfg.split, nb, _MP, n), dtype=torch.float32, device=x.device
+        )
+        counter = _counter(current_stream().cuda_stream)
+    _ll_gemm_kernel[(n_tiles, nb, cfg.split)](
+        x,
+        w,
+        bias,
+        out,
+        partials,
+        counter,
+        m,
+        n,
+        k,
+        x.stride(0),
+        x.stride(1),
+        w.stride(0),
+        w.stride(1),
+        out.stride(0),
+        out.stride(1),
+        BN=cfg.bn,
+        BK=cfg.bk,
+        K_PER_SPLIT=cfg.k_per_split,
+        SPLIT=cfg.split,
+        MP=_MP,
+        num_warps=cfg.num_warps,
+        num_stages=cfg.num_stages,
+        launch_pdl=True,
+    )
+
+
+def use_qkv_bmm(
+    x_q: torch.Tensor, x_k: torch.Tensor, x_v: torch.Tensor, w: torch.Tensor
+) -> bool:
+    """Whether `qkv_bmm` serves bf16 `x_q`, `x_k`, `x_v` `[M, K]` and `w`."""
+    return (
+        x_q.is_cuda
+        and x_q.ndim == 2
+        and 0 < x_q.shape[0] <= MAX_M
+        and x_q.shape == x_k.shape == x_v.shape
+        and x_q.dtype == x_k.dtype == x_v.dtype == w.dtype == torch.bfloat16
+        and x_q.stride(1) == x_k.stride(1) == x_v.stride(1) == w.stride(1) == 1
+        and current_platform.is_device_capability_family(120)
+    )
+
+
+def qkv_bmm(
+    x_q: torch.Tensor,
+    x_k: torch.Tensor,
+    x_v: torch.Tensor,
+    w: torch.Tensor,
+    k_start: int,
+    v_start: int,
+) -> torch.Tensor:
+    """One launch of three linears on consecutive row ranges of `w` `[N, K]`:
+    output columns `[0, k_start)` from `x_q`, `[k_start, v_start)` from `x_k`
+    and the rest from `x_v`, each `[M, K]` with M <= 16. Returns `[M, N]`
+    with fp32 accumulation."""
+    xs = (x_q, x_k, x_v)
+    m, k = x_q.shape
+    n = w.shape[0]
+    s1, s2 = k_start, v_start
+    bn = 32
+    assert 0 < m <= MAX_M and w.shape == (n, k)
+    assert all(x.shape == (m, k) and x.stride(1) == 1 for x in xs)
+    assert w.stride(1) == 1 and s1 > 0 and s1 + bn <= s2 <= n  # one boundary per tile
+    assert max(n * w.stride(0), *(m * x.stride(0) for x in xs)) < 2**31
+    out = torch.empty((m, n), dtype=x_q.dtype, device=x_q.device)
+    # About 1.6 waves of 32-column tiles at Inkling's 8608 columns; wider
+    # tiles or split-K measured no faster.
+    _qkv_bmm_kernel[(triton.cdiv(n, bn),)](
+        x_q,
+        x_k,
+        x_v,
+        w,
+        out,
+        m,
+        n,
+        k,
+        s1,
+        s2,
+        x_q.stride(0),
+        x_k.stride(0),
+        x_v.stride(0),
+        w.stride(0),
+        out.stride(0),
+        BN=bn,
+        BK=128,
+        MP=_MP,
+        num_warps=4,
+        num_stages=4,
+        launch_pdl=True,
+    )
+    return out
+
+
+def sm12x_bf16_ll_gemm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    out_dtype: torch.dtype | None = None,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Low-latency `x @ weight.T` (+ `bias` `[N]`) for at most `MAX_M` rows,
+    with fp32 accumulation, into `out` if given. `weight` `[N, K]` takes `x`
+    `[..., K]` -> `[..., N]`; `weight` `[B, N, K]` takes `x` `[B, M, K]` ->
+    `[B, M, N]`."""
+    n = weight.shape[-2]
+    if weight.ndim == 3:
+        if out is None:
+            out = x.new_empty((*x.shape[:2], n), dtype=out_dtype or x.dtype)
+        _ll_gemm(x, weight, bias, out)
+        return out
+    lead = x.shape[:-1]
+    x2 = x.reshape(-1, x.shape[-1])
+    if out is None:
+        out = x.new_empty((x2.shape[0], n), dtype=out_dtype or x.dtype)
+    if x2.shape[0]:
+        _ll_gemm(x2[None], weight[None], bias, out[None])
+    return out.view(*lead, n)
+
+
+def use_sm12x_bf16_ll_gemm(
+    x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor | None = None
+) -> bool:
+    """Whether `sm12x_bf16_ll_gemm` serves these operands."""
+    if weight.ndim == 2:
+        shapes_ok = x.ndim >= 2
+        m = x.numel() // max(x.shape[-1], 1)
+    else:
+        shapes_ok = weight.ndim == 3 and x.ndim == 3 and x.shape[0] == weight.shape[0]
+        m = x.shape[-2] if x.ndim >= 2 else 0
+    return (
+        shapes_ok
+        and x.is_cuda
+        and weight.device == x.device
+        and x.dtype == weight.dtype == torch.bfloat16
+        and x.shape[-1] == weight.shape[-1]
+        and x.stride(-1) == weight.stride(-1) == 1
+        and 0 < m <= MAX_M
+        and (
+            bias is None
+            or (
+                bias.dtype == torch.bfloat16
+                and bias.device == x.device
+                and bias.stride(0) == 1
+            )
+        )
+        and current_platform.is_device_capability_family(120)
+    )
