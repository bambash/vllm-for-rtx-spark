+@gluon.jit
+def _verify_softmax(
+    s_tmem,
+    o_tmem,
+    s_ready,
+    p_ready,
+    o_done,
+    o_final,
+    Rel,
+    OPart,
+    LsePart,
+    Gate,
+    Sink,
+    Y,
+    stride_gate,
+    stride_sink,
+    q_start,
+    q_len,
+    seqlen_k,
+    pos0,
+    kv_head,
+    split,
+    num_splits,
+    num_tokens,
+    n_first,
+    n_bias,
+    num_iters,
+    fa_mask_left,
+    fa_mask_right,
+    softmax_scale,
+    stride_rel_t,
+    rel_base,
+    H: gl.constexpr,
+    G: gl.constexpr,
+    D: gl.constexpr,
+    REL: gl.constexpr,
+    REL_PAD: gl.constexpr,
+    IS_LOCAL: gl.constexpr,
+    BLOCK_M: gl.constexpr,
+    BLOCK_N: gl.constexpr,
+    FA_BLOCK: gl.constexpr,
+    FUSE_GATE: gl.constexpr,
+    DRAFT: gl.constexpr,
+    WINDOW: gl.constexpr,
+):
+    """Online softmax following FA4 per element.
+
+    `qk + bias / scale` as an FMA, lazy rescaling (threshold 8),
+    `ex2(qk * scale_log2 - max * scale_log2)` with FA4's ex2 emulation
+    columns on blocks without causal or window masking, bf16 P, fp32 row sums.
+    O is rescaled in tensor memory only when some row's max moved by more
+    than the lazy-rescale threshold, after the previous P @ V completed.
+    """
+    num_warps: gl.constexpr = gl.num_warps()
+    s_layout: gl.constexpr = s_tmem.index(0).get_reg_layout(num_warps)
+    o_layout: gl.constexpr = o_tmem.get_reg_layout(num_warps)
+    row_layout: gl.constexpr = gl.SliceLayout(1, s_layout)
+    o_row_layout: gl.constexpr = gl.SliceLayout(1, o_layout)
+
+    rows = gl.arange(0, BLOCK_M, row_layout)
+    tok = rows // G
+    row_valid = (rows < BLOCK_M // G * G) & (tok < q_len)
+    pos = gl.full([BLOCK_M], 0, gl.int32, row_layout) + pos0 if DRAFT else pos0 + tok
+    offs_n = gl.arange(0, BLOCK_N, gl.SliceLayout(0, s_layout))
+    gl.static_assert(BLOCK_N == FA_BLOCK)
+    emu_col = (offs_n // 32 % 3 != 0) & (offs_n % 16 >= 12)
+    head = kv_head * G + rows % G
+    token = (q_start + tok).to(gl.int64)
+
+    inv_scale = 1.0 / softmax_scale
+    scale_log2 = softmax_scale * 1.4426950408889634
+    m_i = gl.full([BLOCK_M], float("-inf"), gl.float32, row_layout)
+    l_i = gl.full([BLOCK_M], 0.0, gl.float32, row_layout)
+    if not DRAFT:
+        # The bias of the next block is loaded ahead.
+        b_row = Rel + token * stride_rel_t + head * REL_PAD - rel_base
+        b_ptrs = b_row[:, None] + offs_n[None, :]
+        bias_next = gl.load(
+            b_ptrs + n_first * BLOCK_N,
+            mask=row_valid[:, None] & (n_first >= n_bias) & (num_iters > 0),
+            other=0.0,
+        )
+    for i in range(num_iters):
+        n = n_first + i * num_splits
+        if not DRAFT:
+            bias = bias_next
+            bias_next = gl.load(
+                b_ptrs + (n + num_splits) * BLOCK_N,
+                mask=row_valid[:, None]
+                & (n + num_splits >= n_bias)
+                & (i + 1 < num_iters),
+                other=0.0,
+            )
+        _bw.mbarrier.wait(s_ready.index(i % 2), i // 2 & 1)
+        s = s_tmem.index(i % 2).load(s_layout)
+        emu = emu_col
+        if n >= n_bias:
+            if not DRAFT:
+                s = gl.fma(bias.to(gl.float32), inv_scale, s)
+            # Only blocks with future keys or keys left of a query's window.
+            key0 = n * BLOCK_N
+            if key0 + BLOCK_N - 1 > pos0 or (IS_LOCAL and key0 < seqlen_k - WINDOW):
+                dist = pos[:, None] - (key0 + offs_n)[None, :]
+                visible = dist >= 0
+                if IS_LOCAL:
+                    visible &= dist < WINDOW
+                s = gl.where(visible, s, float("-inf"))
+            fa_block = key0 // FA_BLOCK
+            emu &= (fa_block < fa_mask_right) & (fa_block >= fa_mask_left)
+
+        m_new = gl.maximum(m_i, gl.max(s, 1))
+        m_safe = gl.where(m_new == float("-inf"), 0.0, m_new)
+        alpha_log2 = (m_i - m_safe) * scale_log2
+        keep = alpha_log2 >= -8.0
+        alpha = gl.where(keep, 1.0, _gl_ex2(alpha_log2))
+        m_use = gl.where(keep, m_i, m_safe)
+        m_i = gl.where(keep, m_i, m_new)
+        x = gl.fma(s, scale_log2, -(m_use * scale_log2)[:, None])
+        p = gl.where(emu[None, :], _gl_ex2_emu(x), _gl_ex2(x))
+        l_i = l_i * alpha + gl.sum(p, 1)
+        if i > 0 and gl.min(alpha, 0) < 1.0:
+            _bw.mbarrier.wait(o_done, i - 1 & 1)
+            o = o_tmem.load(o_layout)
+            o_tmem.store(o * gl.convert_layout(alpha, o_row_layout)[:, None])
+        _verify_p(s_tmem, i % 2, BLOCK_M, BLOCK_N).store(p.to(gl.bfloat16))
+        _bw.mbarrier.arrive(p_ready.index(i % 2), count=1)
+
+    # The combine kernel (PDL) may start loading the gate and sink.
+    gl.inline_asm_elementwise(
+        "griddepcontrol.launch_dependents; // $0",
+        "=r",
+        [],
+        dtype=gl.int32,
+        is_pure=False,
+        pack=1,
+    )
+    empty = (l_i == 0.0) | (l_i != l_i)
+    lse = gl.where(empty, float("-inf"), m_i * scale_log2 + _gl_lg2(l_i))
+    o_valid = gl.convert_layout(row_valid, o_row_layout)
+    offs_d = gl.arange(0, D, gl.SliceLayout(0, o_layout))
+    if num_iters > 0:
+        _bw.mbarrier.wait(o_final, 0)
+        inv_l = _gl_rcp(gl.where(empty, 1.0, l_i))
+        o = o_tmem.load(o_layout) * gl.convert_layout(inv_l, o_row_layout)[:, None]
+    else:
+        o = gl.full([BLOCK_M, D], 0.0, gl.float32, o_layout)
+    if FUSE_GATE and DRAFT:
+        col = gl.convert_layout(head * D, o_row_layout)[:, None] + offs_d[None, :]
+        token_o = gl.convert_layout(token, o_row_layout)[:, None]
+        gl.store(Y + token_o * (H * D) + col, o, mask=o_valid[:, None])
+    elif FUSE_GATE:
+        # A single split: apply the combine kernel's gate and sink here.
+        lse_e = gl.convert_layout(lse * 0.6931471805599453, o_row_layout)
+        sink = gl.load(Sink + token * stride_sink + head, mask=row_valid, other=0.0)
+        sink = gl.convert_layout(sink.to(gl.float32), o_row_layout)
+        col = gl.convert_layout(head * D, o_row_layout)[:, None] + offs_d[None, :]
+        token_o = gl.convert_layout(token, o_row_layout)[:, None]
+        gate = gl.load(
+            Gate + token_o * stride_gate + col, mask=o_valid[:, None], other=0.0
+        )
+        y = o * _gl_sigmoid(gate.to(gl.float32))
+        y = y * _gl_sigmoid(lse_e - sink)[:, None]
+        gl.store(Y + token_o * (H * D) + col, y, mask=o_valid[:, None])
+    else:
+        out = (split * num_tokens + q_start + tok) * H + head
+        gl.store(LsePart + out, lse, mask=row_valid)
+        o_rows = gl.convert_layout(out, o_row_layout)
+        gl.store(
+            OPart + o_rows[:, None] * D + offs_d[None, :], o, mask=o_valid[:, None]
+        )
+
+
+@gluon.jit
+def _rel_verify_kernel(
+    Q,
+    kv_desc,
+    Rel,
+    BlockTable,
+    SeqLens,
+    CuSeqlensQ,
+    OPart,
+    LsePart,
+    Gate,
+    Sink,
+    Y,
+    softmax_scale,
+    stride_q_t,
+    stride_rel_t,
+    stride_bt,
+    stride_gate,
+    stride_sink,
+    page_rows,
+    head_rows,
+    head_cols,
+    num_splits,
+    num_tokens,
+    H: gl.constexpr,
+    HKV: gl.constexpr,
+    D: gl.constexpr,
+    REL: gl.constexpr,
+    REL_PAD: gl.constexpr,
+    PAGE: gl.constexpr,
+    IS_LOCAL: gl.constexpr,
+    BLOCK_M: gl.constexpr,
+    BLOCK_N: gl.constexpr,
+    FA_BLOCK: gl.constexpr,
+    STAGES: gl.constexpr,
+    FUSE_GATE: gl.constexpr,
+    DRAFT: gl.constexpr,
+    WINDOW: gl.constexpr,
+):
+    """One split of one request and KV head: fp32 partial output, log2 LSE.
+
+    One CTA holds all of a request's queries for one KV head (M = 64 rows of
+    tokens x GQA group): a TMA warp streams K/V, an MMA warp runs tcgen05
+    S = Q K^T into double-buffered tensor memory and O += P V, and the
+    default warps run the softmax and write the partials. Split `s` takes
+    key blocks `s, s + num_splits, ...` (of the window, for local layers).
+    `Rel` holds the sheared relative logits of `attention_prologue`: key
+    `k` of a request is column `k - (cdiv(seqlen_k, 128) * 128 - REL_PAD)`.
+    `DRAFT` is plain block attention (the DSpark drafter): no relative
+    logits, gate or sink, and every query of a request sits at its last
+    position. Local layers see `WINDOW` keys up to a query's position.
+    """
+    G: gl.constexpr = H // HKV
+    split = gl.program_id(0)
+    kv_head = gl.program_id(1)
+    req = gl.program_id(2)
+    q_start = gl.load(CuSeqlensQ + req)
+    q_len = gl.load(CuSeqlensQ + req + 1) - q_start
+    seqlen_k = gl.load(SeqLens + req)
+    past = seqlen_k - q_len
+    # The first query's position, and the first block with relative logits.
+    if DRAFT:
+        pos0 = seqlen_k - 1
+        n_bias = 0
+    else:
+        pos0 = past
+        n_bias = gl.maximum(past - (REL - 1), 0) // BLOCK_N
+    n_first = split
+    fa_mask_left = 0
+    if IS_LOCAL:
+        n_first += gl.maximum(pos0 - (WINDOW - 1), 0) // BLOCK_N
+        fa_mask_left = gl.cdiv(pos0 + FA_BLOCK - (WINDOW - 1), FA_BLOCK)
+    fa_mask_right = pos0 // FA_BLOCK
+    # Key of column 0 of the sheared relative logits.
+    rel_base = gl.cdiv(seqlen_k, FA_BLOCK) * FA_BLOCK - REL_PAD
+    num_iters = gl.maximum(gl.cdiv(gl.cdiv(seqlen_k, BLOCK_N) - n_first, num_splits), 0)
+
+    smem_layout: gl.constexpr = gl.NVMMASharedLayout(
+        swizzle_byte_width=128, element_bitwidth=16
+    )
+    q_layout: gl.constexpr = gl.BlockedLayout(
+        [1, 8], [4, 8], [gl.num_warps(), 1], [1, 0]
+    )
+    rows = gl.arange(0, BLOCK_M, gl.SliceLayout(1, q_layout))
+    offs_d = gl.arange(0, D, gl.SliceLayout(0, q_layout))
+    tok = rows // G
+    row_valid = (rows < BLOCK_M // G * G) & (tok < q_len)
+    token = (q_start + tok).to(gl.int64)
+    q_ptrs = Q + token[:, None] * stride_q_t + (kv_head * G + rows % G)[:, None] * D
+
+    s_layout: gl.constexpr = _bw.TensorMemoryLayout((BLOCK_M, BLOCK_N), col_stride=1)
+    o_layout: gl.constexpr = _bw.TensorMemoryLayout((BLOCK_M, D), col_stride=1)
+    k_smem = gl.allocate_shared_memory(
+        gl.bfloat16, [STAGES, BLOCK_N, D], kv_desc.layout
+    )
+    v_smem = gl.allocate_shared_memory(
+        gl.bfloat16, [STAGES, BLOCK_N, D], kv_desc.layout
+    )
+    s_tmem = _bw.allocate_tensor_memory(gl.float32, [2, BLOCK_M, BLOCK_N], s_layout)
+    o_tmem = _bw.allocate_tensor_memory(gl.float32, [BLOCK_M, D], o_layout)
+    bar_layout: gl.constexpr = _bw.mbarrier.MBarrierLayout()
+    kv_ready = gl.allocate_shared_memory(gl.int64, [STAGES, 1], bar_layout)
+    kv_empty = gl.allocate_shared_memory(gl.int64, [STAGES, 1], bar_layout)
+    s_ready = gl.allocate_shared_memory(gl.int64, [2, 1], bar_layout)
+    p_ready = gl.allocate_shared_memory(gl.int64, [2, 1], bar_layout)
+    o_done = gl.allocate_shared_memory(gl.int64, [1], bar_layout)
+    o_final = gl.allocate_shared_memory(gl.int64, [1], bar_layout)
+    for k in gl.static_range(STAGES):
+        _bw.mbarrier.init(kv_ready.index(k), count=1)
+        _bw.mbarrier.init(kv_empty.index(k), count=1)
+    for k in gl.static_range(2):
+        _bw.mbarrier.init(s_ready.index(k), count=1)
+        _bw.mbarrier.init(p_ready.index(k), count=1)
+    _bw.mbarrier.init(o_done, count=1)
+    _bw.mbarrier.init(o_final, count=1)
+
+    _bw.fence_async_shared()
+    gl.barrier()
+    # Key blocks before the new tokens were cached by earlier steps: load the
+    # first of them while the producer of Q and the new keys (PDL) finishes.
+    num_old = gl.maximum(gl.cdiv(past // BLOCK_N - n_first, num_splits), 0)
+    num_pre = gl.minimum(gl.minimum(num_old, num_iters), STAGES)
+    for i in gl.static_range(STAGES):
+        if i < num_pre:
+            _verify_load_block(
+                kv_desc,
+                k_smem,
+                v_smem,
+                kv_ready,
+                BlockTable,
+                req,
+                kv_head,
+                stride_bt,
+                n_first,
+                num_splits,
+                i,
+                page_rows,
+                head_rows,
+                head_cols,
+                PAGE,
+                BLOCK_N,
+                D,
+                STAGES,
+            )
+    gl.inline_asm_elementwise(
+        "griddepcontrol.wait; // $0", "=r", [], dtype=gl.int32, is_pure=False, pack=1
+    )
+    q = gl.load(q_ptrs + offs_d[None, :], mask=row_valid[:, None], other=0.0)
+    q_smem = gl.allocate_shared_memory(gl.bfloat16, [BLOCK_M, D], smem_layout, q)
+    _bw.fence_async_shared()
+
+    gl.warp_specialize(
+        [
+            (
+                _verify_softmax,
+                (
+                    s_tmem,
+                    o_tmem,
+                    s_ready,
+                    p_ready,
+                    o_done,
+                    o_final,
+                    Rel,
+                    OPart,
+                    LsePart,
+                    Gate,
+                    Sink,
+                    Y,
+                    stride_gate,
+                    stride_sink,
+                    q_start,
+                    q_len,
+                    seqlen_k,
+                    pos0,
+                    kv_head,
+                    split,
+                    num_splits,
+                    num_tokens,
+                    n_first,
+                    n_bias,
+                    num_iters,
+                    fa_mask_left,
+                    fa_mask_right,
+                    softmax_scale,
+                    stride_rel_t,
+                    rel_base,
+                    H,
+                    G,
+                    D,
+                    REL,
+                    REL_PAD,
+                    IS_LOCAL,
+                    BLOCK_M,
+                    BLOCK_N,
+                    FA_BLOCK,
+                    FUSE_GATE,
+                    DRAFT,
+                    WINDOW,
+                ),
+            ),
+            (
+                _verify_load,
+                (
+                    kv_desc,
+                    k_smem,
+                    v_smem,
+                    kv_ready,
+                    kv_empty,
+                    BlockTable,
+                    req,
+                    kv_head,
+                    stride_bt,
+                    n_first,
+                    num_splits,
+                    num_pre,
+                    num_iters,
+                    page_rows,
+                    head_rows,
+                    head_cols,
+                    PAGE,
+                    BLOCK_N,
+                    D,
+                    STAGES,
+                ),
+            ),
+            (
+                _verify_mma,
+                (
+                    q_smem,
+                    k_smem,
+                    v_smem,
+                    s_tmem,
+                    o_tmem,
+                    kv_ready,
+                    kv_empty,
+                    s_ready,
+                    p_ready,
+                    o_done,
+                    o_final,
+                    num_iters,
+                    BLOCK_M,
+                    BLOCK_N,
+                    STAGES,
+                ),
+            ),
+        ],
+        [1, 1],
+        [24, 24],
+    )
+
+
+def rel_decode_attention(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    rel_logits: torch.Tensor,
+    gate: torch.Tensor,
+    sinks: torch.Tensor,
+    out: torch.Tensor,
+    *,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_query_len: int,
+    num_actual_tokens: int,
+    softmax_scale: float,
+    is_local: bool,
+    num_splits: int,
+) -> None:
+    """Write the gated bf16 `(T, H * D)` attention output for small batches.
+
+    Split-KV relative attention on `_rel_verify_kernel` (see
+    `plan_decode_attention`) reading the sheared relative logits. With more
+    than one split, a second launch merges the fp32 partials and applies the
+    output gate and attention sink. Tokens from `num_actual_tokens` on are
+    zeroed.
+    """
+    num_tokens, num_heads = q.shape[:2]
+    extent_pad = rel_logits.shape[2]
+    extent = extent_pad - 2 * _FA4_BLOCK_N
+    assert rel_logits.shape[0] >= num_tokens and rel_logits.shape[1] == num_heads
+    assert rel_logits.stride(1) == extent_pad and rel_logits.stride(2) == 1
+    assert extent % _FA4_BLOCK_N == 0
+    assert gate.stride(1) == sinks.stride(1) == 1
+    _decode_attention(
+        q,
+        key_cache,
+        value_cache,
+        out,
+        (rel_logits, gate, sinks),
+        block_table,
+        cache_seqlens,
+        cu_seqlens_q,
+        max_query_len,
+        num_actual_tokens,
+        softmax_scale,
+        extent if is_local else 0,
+        num_splits,
+    )
+
+
+def block_decode_attention(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    out: torch.Tensor,
+    *,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    block: int,
+    window: int,
+    num_splits: int,
+) -> None:
+    """Write the bf16 `(T, H * D)` attention of each `block`-token request
+    to `out`: every query sees the request's keys up to its last one, or the
+    last `window` of them if `window` (the DSpark draft block attention).
+
+    Runs `_rel_verify_kernel` like `rel_decode_attention`, without the
+    relative logits, gate and sink.
+    """
+    _decode_attention(
+        q,
+        key_cache,
+        value_cache,
+        out,
+        None,
+        block_table,
+        cache_seqlens,
+        cu_seqlens_q,
+        block,
+        q.shape[0],
+        q.shape[2] ** -0.5,
+        window,
+        num_splits,
+    )
+
+
+def _decode_attention(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    out: torch.Tensor,
+    rel_gate_sinks: tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_query_len: int,
+    num_actual_tokens: int,
+    softmax_scale: float,
+    window: int,
+    num_splits: int,
+) -> None:
+    """Launch `_rel_verify_kernel` (and the combine for several splits);
+    `rel_gate_sinks` None is the draft mode, `window` 0 a full layer."""
+    num_tokens, num_heads, head_dim = q.shape
+    num_blocks, page, num_kv_heads = key_cache.shape[:3]
+    group = num_heads // num_kv_heads
+    draft = rel_gate_sinks is None
+    if rel_gate_sinks is None:
+        # Unused placeholders keep the launches typed alike.
+        rel_logits = gate = sinks = out
+        extent = 0
+    else:
+        rel_logits, gate, sinks = rel_gate_sinks
+        extent = rel_logits.shape[2] - 2 * _FA4_BLOCK_N
+    assert max_query_len <= _VERIFY_BLOCK_M // group
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1
+    assert q.stride(1) == head_dim and q.stride(2) == 1
+    assert out.is_contiguous()
+    # A single split writes the (gated) output itself.
+    fuse_gate = num_splits == 1
+    o_part = q.new_empty(
+        (0 if fuse_gate else num_splits, *q.shape), dtype=torch.float32
+    )
+    lse_part = q.new_empty(
+        (0 if fuse_gate else num_splits, num_tokens, num_heads), dtype=torch.float32
+    )
+    if use_sm100_kernels():
+        _launch_rel_verify(
+            q,
+            key_cache,
+            value_cache,
+            out,
+            o_part,
+            lse_part,
+            rel_logits,
+            gate,
+            sinks,
+            block_table,
+            cache_seqlens,
+            cu_seqlens_q,
+            softmax_scale,
+            extent,
+            window,
+            num_splits,
+            draft,
+        )
+    else:
+        rel_attention(
+            q,
+            key_cache,
+            value_cache,
+            out if fuse_gate else o_part,
+            None if fuse_gate else lse_part,
+            None if draft else rel_logits,
+            gate,
+            sinks,
+            block_table=block_table,
+            cache_seqlens=cache_seqlens,
+            cu_seqlens_q=cu_seqlens_q,
+            max_query_len=max_query_len,
+            softmax_scale=softmax_scale,
+            window=window,
+            num_splits=num_splits,
+            mode=MODE_GATED if fuse_gate else MODE_PARTIAL,
+        )
+    if fuse_gate:
+        out[num_actual_tokens:].zero_()
+        return
+    # Small batches spread the merge over more programs; larger ones merge a
+    # whole head per (narrow) program.
+    if num_tokens * num_heads >= 512:
+        block_d, num_warps = head_dim, 2 if num_splits > 32 else 1
+    else:
+        block_d, num_warps = 32, 4
+    _rel_decode_combine_kernel[(num_tokens, num_heads, head_dim // block_d)](
+        o_part,
+        lse_part,
+        gate,
+        sinks,
+        out,
+        num_tokens,
+        num_actual_tokens,
+        gate.stride(0),
+        sinks.stride(0),
+        H=num_heads,
+        D=head_dim,
+        NUM_SPLITS=num_splits,
+        BLOCK_S=triton.next_power_of_2(num_splits),
+        BLOCK_D=block_d,
+        GATED=not draft,
+        num_warps=num_warps,
+        launch_pdl=True,
+    )
+
+
+def _launch_rel_verify(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    out: torch.Tensor,
+    o_part: torch.Tensor,
+    lse_part: torch.Tensor,
+    rel_logits: torch.Tensor,
+    gate: torch.Tensor,
+    sinks: torch.Tensor,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    softmax_scale: float,
+    extent: int,
+    window: int,
+    num_splits: int,
+    draft: bool,
+) -> None:
+    num_tokens, num_heads, head_dim = q.shape
+    num_blocks, page, num_kv_heads = key_cache.shape[:3]
+    grid = (num_splits, num_kv_heads, cache_seqlens.shape[0])
+    fuse_gate = num_splits == 1
+    # The paged cache as 2D rows of (K | V) per KV head: a page's slots
+    # are rows, KV heads sit either side by side in a row or in row blocks.
+    page_stride, slot_stride, head_stride = key_cache.stride()[:3]
+    assert value_cache.data_ptr() == key_cache.data_ptr() + head_dim * 2
+    assert page_stride % slot_stride == 0 and slot_stride >= 2 * head_dim
+    if head_stride < slot_stride:
+        head_rows, head_cols = 0, head_stride
+    else:
+        assert head_stride % slot_stride == 0
+        head_rows, head_cols = head_stride // slot_stride, 0
+    kv_rows = key_cache.as_strided(
+        (num_blocks * page_stride // slot_stride, slot_stride), (slot_stride, 1)
+    )
+    block = [min(page, _FA4_BLOCK_N), head_dim]
+    kv_desc = gluon.nvidia.hopper.TensorDescriptor.from_tensor(
+        kv_rows, block, gl.NVMMASharedLayout.get_default_for(block, gl.bfloat16)
+    )
+    _rel_verify_kernel[grid](
+        q,
+        kv_desc,
+        rel_logits,
+        block_table,
+        cache_seqlens,
+        cu_seqlens_q,
+        o_part,
+        lse_part,
+        gate,
+        sinks,
+        out,
+        softmax_scale,
+        q.stride(0),
+        rel_logits.stride(0),
+        block_table.stride(0),
+        gate.stride(0),
+        sinks.stride(0),
+        page_stride // slot_stride,
+        head_rows,
+        head_cols,
+        num_splits,
+        num_tokens,
+        H=num_heads,
+        HKV=num_kv_heads,
+        D=head_dim,
+        REL=extent,
+        REL_PAD=extent + 2 * _FA4_BLOCK_N,
+        PAGE=page,
+        IS_LOCAL=window > 0,
+        BLOCK_M=_VERIFY_BLOCK_M,
+        BLOCK_N=_FA4_BLOCK_N,
+        FA_BLOCK=_FA4_BLOCK_N,
+        STAGES=_VERIFY_STAGES,
+        FUSE_GATE=fuse_gate,
+        DRAFT=draft,
+        WINDOW=window,
+        num_warps=4,
+        launch_pdl=True,
+    )
diff --git a/vllm/models/inkling2/nvidia/ops/attention_sm90.py b/vllm/models/inkling2/nvidia/ops/attention_sm90.py
new file mode 100644
index 0000000..8f53630
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/attention_sm90.py
@@ -0,0 +1,343 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 relative-bias paged attention for Hopper and SM12x (Triton).
+
+Stands in for tml_fa4 (prefill) and the tcgen05 decode/verify kernel of
+`ops/attention.py`, reading the same sheared relative logits of
+`attention_prologue`: column `c` of token `t` holds key
+`c + cdiv(past + tile_end, 128) * 128 - (E + 256)`, where `tile_end` ends
+the token's 128-row query tile (see `qr_clip_rel_tokens`).
+
+A program owns `BLOCK_M` rows (tokens x GQA group) of one request and KV
+head, and one KV split: split `s` of `S` takes key blocks `s, s + S, ...`
+of the rows' visible range, so a split count that depends only on the batch
+holds for every replay of a CUDA graph.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+# The query tile of tml_fa4 that shears the relative logits.
+_SHEAR_TILE = tl.constexpr(128)
+
+# Output of `_rel_attention_kernel`: fp32 output and natural-log LSE (the
+# tml_fa4 replacement), the gated bf16 output, or fp32 split partials with
+# log2 LSEs (merged by `_rel_decode_combine_kernel`).
+MODE_OUT_LSE = 0
+MODE_GATED = 1
+MODE_PARTIAL = 2
+
+
+@triton.jit
+def _sigmoid(x):
+    return 1.0 / (1.0 + tl.exp2(-x * 1.4426950408889634))
+
+
+@triton.jit
+def _load_fp8_kv(ptr, offsets, mask, dtype: tl.constexpr, D: tl.constexpr):
+    # Load each E4M3 pair once, retaining 16-bit packing for BF16 MMA order.
+    half = tl.arange(0, D // 2)
+    pair = tl.load(
+        ptr.to(tl.pointer_type(tl.uint16))
+        + tl.multiple_of(offsets // 2, D // 2)[:, None]
+        + half[None, :],
+        mask=mask[:, None],
+        other=0,
+    )
+    lo, hi = tl.inline_asm_elementwise(
+        "{ .reg .b32 pair; cvt.rn.f16x2.e4m3x2 pair, $2; mov.b32 {$0, $1}, pair; }",
+        "=h,=h,h",
+        [pair],
+        dtype=(tl.float16, tl.float16),
+        is_pure=True,
+        pack=1,
+    )
+    return tl.interleave(lo, hi).to(dtype)
+
+
+@triton.jit
+def _rel_attention_kernel(
+    Q,
+    K,
+    V,
+    Rel,
+    BlockTable,
+    SeqLens,
+    CuSeqlensQ,
+    Out,
+    Lse,
+    Gate,
+    Sink,
+    softmax_scale,
+    num_tokens,
+    num_splits,
+    stride_q_t,
+    stride_q_h,
+    stride_kv_blk,
+    stride_kv_slot,
+    stride_kv_h,
+    stride_rel_t,
+    stride_bt,
+    stride_out_t,
+    stride_out_h,
+    stride_lse_h,
+    stride_lse_t,
+    stride_gate,
+    stride_sink,
+    H: tl.constexpr,
+    G: tl.constexpr,
+    D: tl.constexpr,
+    E: tl.constexpr,
+    PAGE: tl.constexpr,
+    WINDOW: tl.constexpr,
+    DRAFT: tl.constexpr,
+    MODE: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+):
+    TOKENS: tl.constexpr = BLOCK_M // G
+    E_PAD: tl.constexpr = E + 256
+    LOG2E: tl.constexpr = 1.4426950408889634
+    m_tile = tl.program_id(0)
+    kv_head = tl.program_id(1) // num_splits
+    split = tl.program_id(1) % num_splits
+    req = tl.program_id(2)
+    q_start = tl.load(CuSeqlensQ + req)
+    q_len = tl.load(CuSeqlensQ + req + 1) - q_start
+    first_tok = m_tile * TOKENS
+    if first_tok >= q_len:
+        return
+    seqlen_k = tl.load(SeqLens + req)
+    past = seqlen_k - q_len
+
+    rows = tl.arange(0, BLOCK_M)
+    tok = first_tok + rows // G
+    row_valid = (rows < TOKENS * G) & (tok < q_len)
+    head = kv_head * G + rows % G
+    token = (q_start + tok).to(tl.int64)
+    if DRAFT:
+        pos = tl.zeros([BLOCK_M], tl.int32) + seqlen_k - 1
+        pos_lo = seqlen_k - 1
+        pos_hi = seqlen_k - 1
+    else:
+        pos = past + tok
+        pos_lo = past + first_tok
+        pos_hi = past + tl.minimum(first_tok + TOKENS, q_len) - 1
+    # Visible key blocks of the tile, split `split` taking every
+    # `num_splits`-th of them.
+    n_lo = 0
+    if WINDOW > 0:
+        n_lo = tl.maximum(pos_lo - (WINDOW - 1), 0) // BLOCK_N
+    n_hi = tl.minimum(pos_hi + 1, seqlen_k)
+    n_hi = (n_hi + BLOCK_N - 1) // BLOCK_N
+    num_iters = tl.maximum(n_hi - n_lo - split + num_splits - 1, 0) // num_splits
+
+    offs_d = tl.arange(0, D)
+    q = tl.load(
+        Q + token[:, None] * stride_q_t + head[:, None] * stride_q_h + offs_d[None, :],
+        mask=row_valid[:, None],
+        other=0.0,
+    )
+    if not DRAFT:
+        tile_end = tl.minimum((tok // _SHEAR_TILE + 1) * _SHEAR_TILE, q_len)
+        rel_base = (past + tile_end + 127) // 128 * 128 - E_PAD
+        rel_row = Rel + token * stride_rel_t + head * E_PAD - rel_base
+
+    qk_scale = softmax_scale * LOG2E
+    m_i = tl.full([BLOCK_M], float("-inf"), tl.float32)
+    l_i = tl.zeros([BLOCK_M], tl.float32)
+    acc = tl.zeros([BLOCK_M, D], tl.float32)
+    block_table = BlockTable + req.to(tl.int64) * stride_bt
+    kv_off = kv_head * stride_kv_h
+    for i in range(num_iters):
+        n = n_lo + split + i * num_splits
+        keys = n * BLOCK_N + tl.arange(0, BLOCK_N)
+        key_valid = keys < seqlen_k
+        page = tl.load(block_table + keys // PAGE, mask=key_valid, other=0)
+        kv_ptrs = (
+            page.to(tl.int64) * stride_kv_blk + (keys % PAGE) * stride_kv_slot + kv_off
+        )
+        if K.dtype.element_ty.primitive_bitwidth == 8:
+            k = _load_fp8_kv(K, kv_ptrs, key_valid, q.dtype, D).T
+        else:
+            k = tl.load(
+                K + kv_ptrs[None, :] + offs_d[:, None],
+                mask=key_valid[None, :],
+                other=0.0,
+            ).to(q.dtype)
+        s = tl.dot(q, k) * qk_scale
+        dist = pos[:, None] - keys[None, :]
+        visible = (dist >= 0) & key_valid[None, :]
+        if WINDOW > 0:
+            visible &= dist < WINDOW
+        if not DRAFT:
+            in_extent = visible & (dist < E) & row_valid[:, None]
+            bias = tl.load(rel_row[:, None] + keys[None, :], mask=in_extent, other=0.0)
+            s += bias.to(tl.float32) * LOG2E
+        s = tl.where(visible, s, float("-inf"))
+        m_new = tl.maximum(m_i, tl.max(s, 1))
+        m_safe = tl.where(m_new == float("-inf"), 0.0, m_new)
+        alpha = tl.exp2(m_i - m_safe)
+        p = tl.exp2(s - m_safe[:, None])
+        l_i = l_i * alpha + tl.sum(p, 1)
+        if V.dtype.element_ty.primitive_bitwidth == 8:
+            v = _load_fp8_kv(V, kv_ptrs, key_valid, q.dtype, D)
+        else:
+            v = tl.load(
+                V + kv_ptrs[:, None] + offs_d[None, :],
+                mask=key_valid[:, None],
+                other=0.0,
+            ).to(q.dtype)
+        acc = acc * alpha[:, None] + tl.dot(p.to(v.dtype), v)
+        m_i = m_new
+
+    empty = l_i == 0.0
+    o = acc / tl.where(empty, 1.0, l_i)[:, None]
+    lse2 = tl.where(empty, float("-inf"), m_i + tl.log2(tl.where(empty, 1.0, l_i)))
+    if MODE == 0:
+        tl.store(
+            Out
+            + token[:, None] * stride_out_t
+            + head[:, None] * stride_out_h
+            + offs_d[None, :],
+            o,
+            mask=row_valid[:, None],
+        )
+        tl.store(
+            Lse + head * stride_lse_h + token * stride_lse_t,
+            lse2 * 0.6931471805599453,
+            mask=row_valid,
+        )
+    elif MODE == 1:
+        cols = head[:, None] * D + offs_d[None, :]
+        if not DRAFT:
+            gate = tl.load(
+                Gate + token[:, None] * stride_gate + cols,
+                mask=row_valid[:, None],
+                other=0.0,
+            )
+            sink = tl.load(Sink + token * stride_sink + head, mask=row_valid, other=0.0)
+            o = o * _sigmoid(gate.to(tl.float32))
+            o = o * _sigmoid(lse2 * 0.6931471805599453 - sink.to(tl.float32))[:, None]
+        tl.store(
+            Out + token[:, None] * stride_out_t + cols,
+            o.to(Out.dtype.element_ty),
+            mask=row_valid[:, None],
+        )
+    else:
+        part = (split * num_tokens + token) * H + head
+        tl.store(Lse + part, lse2, mask=row_valid)
+        tl.store(Out + part[:, None] * D + offs_d[None, :], o, mask=row_valid[:, None])
+
+
+def _block_m(max_query_len: int, group: int) -> int:
+    rows = max_query_len * group
+    return 16 if rows <= 16 else 32 if rows <= 32 else 64 if rows <= 64 else 128
+
+
+def rel_attention(
+    q: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    out: torch.Tensor,
+    lse: torch.Tensor | None,
+    rel_logits: torch.Tensor | None,
+    gate: torch.Tensor | None = None,
+    sinks: torch.Tensor | None = None,
+    *,
+    block_table: torch.Tensor,
+    cache_seqlens: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    max_query_len: int,
+    softmax_scale: float,
+    window: int,
+    num_splits: int,
+    mode: int,
+) -> None:
+    """Launch `_rel_attention_kernel` over the requests of `cu_seqlens_q`.
+
+    `rel_logits` (sheared, `(T + 128, H, extent + 256)`) is None for the
+    DSpark draft: plain block attention with all queries of a request at
+    its last position. `window` (keys up to a query's position, inclusive) is
+    0 for full layers. `mode` selects the output: `MODE_OUT_LSE` writes the
+    fp32 `out` `(T, H, D)` and natural-log `lse` `(H, T)`; `MODE_GATED`
+    the bf16 `(T, H * D)` `out` (gated by `gate` and `sinks` unless
+    drafting; a single split); `MODE_PARTIAL` the fp32 `out`
+    `(S, T, H, D)` and log2 `lse` `(S, T, H)` partials.
+    """
+    num_tokens, num_heads, head_dim = q.shape
+    page, num_kv_heads = key_cache.shape[1:3]
+    group = num_heads // num_kv_heads
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1
+    assert q.stride(2) == 1
+    assert mode != MODE_GATED or num_splits == 1
+    draft = rel_logits is None
+    extent = 0
+    if rel_logits is not None:
+        extent = rel_logits.shape[2] - 256
+        assert rel_logits.stride(1) == rel_logits.shape[2]
+        assert rel_logits.stride(2) == 1
+    if mode == MODE_GATED and not draft:
+        assert gate is not None and sinks is not None
+        assert gate.stride(1) == sinks.stride(1) == 1
+    # Unused pointers keep the launches typed alike.
+    rel = q if rel_logits is None else rel_logits
+    gate = q if gate is None else gate
+    sinks = q if sinks is None else sinks
+    if lse is None:
+        lse = out
+    block_m = _block_m(max_query_len, group)
+    tokens_per_tile = block_m // group
+    num_reqs = cache_seqlens.shape[0]
+    grid = (
+        triton.cdiv(max_query_len, tokens_per_tile),
+        num_kv_heads * num_splits,
+        num_reqs,
+    )
+    if mode == MODE_OUT_LSE:
+        out_strides = (out.stride(0), out.stride(1), lse.stride(0), lse.stride(1))
+    elif mode == MODE_GATED:
+        assert out.is_contiguous()
+        out_strides = (out.stride(0), 0, 0, 0)
+    else:
+        assert out.is_contiguous() and lse.is_contiguous()
+        out_strides = (0, 0, 0, 0)
+    _rel_attention_kernel[grid](
+        q,
+        key_cache,
+        value_cache,
+        rel,
+        block_table,
+        cache_seqlens,
+        cu_seqlens_q,
+        out,
+        lse,
+        gate,
+        sinks,
+        softmax_scale,
+        num_tokens,
+        num_splits,
+        q.stride(0),
+        q.stride(1),
+        key_cache.stride(0),
+        key_cache.stride(1),
+        key_cache.stride(2),
+        rel.stride(0),
+        block_table.stride(0),
+        *out_strides,
+        gate.stride(0),
+        sinks.stride(0),
+        H=num_heads,
+        G=group,
+        D=head_dim,
+        E=extent,
+        PAGE=page,
+        WINDOW=window,
+        DRAFT=draft,
+        MODE=mode,
+        BLOCK_M=block_m,
+        BLOCK_N=64 if block_m >= 128 else 128 if block_m <= 32 else 64,
+        num_warps=8 if block_m >= 128 else 4,
+        num_stages=2,
+    )
diff --git a/vllm/models/inkling2/nvidia/ops/attn_res.py b/vllm/models/inkling2/nvidia/ops/attn_res.py
new file mode 100644
index 0000000..3159003
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/attn_res.py
@@ -0,0 +1,306 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Block attention residual: softmax-weighted mix of residual stream blocks.
+
+For each token, sources `x_n` (stored blocks, then the partial block plus an
+optional addend, all in fp32) are scored as `(q . x_n) * rsqrt(mean(x_n^2) +
+eps)` per pseudo-query `q`; the output is `sum_n softmax_n * x_n`, with
+`x_n` RMS-normalized when `normalize_values` is set. The fp32 mix then
+goes through the following sublayer's RMSNorm in the same kernel, or is
+returned as is (fp32) without a norm weight.
+"""
+
+import torch
+
+from vllm.models.inkling2.nvidia.ops.norm import rsqrt
+from vllm.triton_utils import tl, tldevice, triton
+
+
+@triton.jit
+def _load_source(
+    Stack, stride_s, Last, Addend, row_off, offs, mask, n, N_STACK, HAS_ADDEND
+):
+    if n < N_STACK:
+        x = tl.load(Stack + n * stride_s + row_off + offs, mask, other=0)
+        x = x.to(tl.float32)
+    else:
+        x = tl.load(Last + row_off + offs, mask, other=0).to(tl.float32)
+        if HAS_ADDEND:
+            x = x + tl.load(Addend + row_off + offs, mask, other=0).to(tl.float32)
+    return x
+
+
+@triton.jit
+def _mix(
+    Stack,
+    stride_s,
+    Last,
+    Addend,
+    row_off,
+    offs,
+    mask,
+    probs,
+    n_idx,
+    N_STACK,
+    HAS_ADDEND,
+    BLOCK_D,
+):
+    acc = tl.zeros((BLOCK_D,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        x = _load_source(
+            Stack, stride_s, Last, Addend, row_off, offs, mask, n, N_STACK, HAS_ADDEND
+        )
+        acc = tl.fma(tl.sum(tl.where(n_idx == n, probs, 0.0)), x, acc)
+    return acc
+
+
+@triton.jit
+def _attn_res_kernel(
+    Stack,
+    Last,
+    Addend,
+    Queries,
+    NormW,
+    Out,
+    stride_s,
+    T,
+    eps,
+    norm_eps,
+    D: tl.constexpr,
+    N_STACK: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+    APPLY_NORM: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_D: tl.constexpr,
+):
+    tl.extra.cuda.gdc_wait()
+    # One program per (token, query).
+    t = tl.program_id(1).to(tl.int64)
+    q_off = tl.program_id(0) * D
+    row_off = t * D
+    n_idx = tl.arange(0, BLOCK_N)
+    d_idx = tl.arange(0, BLOCK_D)
+
+    # Pass 1: per-source inverse RMS and query dot products.
+    logits = tl.full((BLOCK_N,), float("-inf"), tl.float32)
+    inv_rms = tl.zeros((BLOCK_N,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        sum_sq = tl.zeros((BLOCK_D,), tl.float32)
+        dots = tl.zeros((BLOCK_D,), tl.float32)
+        for d0 in tl.range(0, D, BLOCK_D):
+            offs = d0 + d_idx
+            mask = offs < D
+            x = _load_source(
+                Stack,
+                stride_s,
+                Last,
+                Addend,
+                row_off,
+                offs,
+                mask,
+                n,
+                N_STACK,
+                HAS_ADDEND,
+            )
+            q = tl.load(Queries + q_off + offs, mask, other=0)
+            sum_sq = tl.fma(x, x, sum_sq)
+            dots = tl.fma(q, x, dots)
+        rstd = rsqrt(tl.fma(tl.sum(sum_sq), 1.0 / D, eps))
+        inv_rms = tl.where(n_idx == n, rstd, inv_rms)
+        logits = tl.where(n_idx == n, tl.sum(dots) * rstd, logits)
+
+    probs = tldevice.exp(logits - tl.max(logits))
+    inv_sum = tl.div_rn(1.0, tl.sum(probs))
+    if NORMALIZE:
+        probs = probs * inv_rms
+
+    # Pass 2: RMS of the probability-weighted sum; pass 3: normalized sum.
+    out_rstd = 1.0
+    if APPLY_NORM:
+        sum_sq = 0.0
+        for d0 in tl.range(0, D, BLOCK_D):
+            offs = d0 + d_idx
+            acc = (
+                _mix(
+                    Stack,
+                    stride_s,
+                    Last,
+                    Addend,
+                    row_off,
+                    offs,
+                    offs < D,
+                    probs,
+                    n_idx,
+                    N_STACK,
+                    HAS_ADDEND,
+                    BLOCK_D,
+                )
+                * inv_sum
+            )
+            sum_sq += tl.sum(acc * acc)
+        out_rstd = rsqrt(tl.div_rn(sum_sq, D) + norm_eps)
+    out = Out + tl.program_id(0).to(tl.int64) * T * D + row_off
+    for d0 in tl.range(0, D, BLOCK_D):
+        offs = d0 + d_idx
+        mask = offs < D
+        acc = (
+            _mix(
+                Stack,
+                stride_s,
+                Last,
+                Addend,
+                row_off,
+                offs,
+                mask,
+                probs,
+                n_idx,
+                N_STACK,
+                HAS_ADDEND,
+                BLOCK_D,
+            )
+            * inv_sum
+        )
+        if APPLY_NORM:
+            w = tl.load(NormW + q_off + offs, mask, other=0).to(tl.float32)
+            acc = acc * out_rstd * w
+        tl.store(out + offs, acc.to(Out.dtype.element_ty), mask)
+
+
+@triton.jit
+def _attn_res_row_kernel(
+    Stack,
+    Last,
+    Addend,
+    Queries,
+    NormW,
+    Out,
+    stride_s,
+    T,
+    eps,
+    norm_eps,
+    D: tl.constexpr,
+    N_STACK: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    NORMALIZE: tl.constexpr,
+    APPLY_NORM: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_A: tl.constexpr,
+    BLOCK_B: tl.constexpr,
+):
+    tl.extra.cuda.gdc_wait()
+    # Small batches: one program per (token, query) holds the row in registers
+    # as a power-of-2 head [0, BLOCK_A) and a masked tail [BLOCK_A, D), so the
+    # sources are read twice instead of three times.
+    t = tl.program_id(1).to(tl.int64)
+    q_off = tl.program_id(0) * D
+    row_off = t * D
+    da = tl.arange(0, BLOCK_A)
+    db = BLOCK_A + tl.arange(0, BLOCK_B)
+    mask_a = da < D
+    mask_b = db < D
+    n_idx = tl.arange(0, BLOCK_N)
+    qa = tl.load(Queries + q_off + da, mask_a, other=0)
+    qb = tl.load(Queries + q_off + db, mask_b, other=0)
+    src = (Stack, stride_s, Last, Addend, row_off)
+
+    logits = tl.full((BLOCK_N,), float("-inf"), tl.float32)
+    inv_rms = tl.zeros((BLOCK_N,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        xa = _load_source(*src, da, mask_a, n, N_STACK, HAS_ADDEND)
+        xb = _load_source(*src, db, mask_b, n, N_STACK, HAS_ADDEND)
+        rstd = rsqrt(tl.fma(tl.sum(xa * xa) + tl.sum(xb * xb), 1.0 / D, eps))
+        inv_rms = tl.where(n_idx == n, rstd, inv_rms)
+        dot = tl.sum(qa * xa) + tl.sum(qb * xb)
+        logits = tl.where(n_idx == n, dot * rstd, logits)
+
+    probs = tldevice.exp(logits - tl.max(logits))
+    inv_sum = tl.div_rn(1.0, tl.sum(probs))
+    if NORMALIZE:
+        probs = probs * inv_rms
+
+    acc_a = tl.zeros((BLOCK_A,), tl.float32)
+    acc_b = tl.zeros((BLOCK_B,), tl.float32)
+    for n in tl.static_range(N_STACK + 1):
+        p = tl.sum(tl.where(n_idx == n, probs, 0.0))
+        xa = _load_source(*src, da, mask_a, n, N_STACK, HAS_ADDEND)
+        xb = _load_source(*src, db, mask_b, n, N_STACK, HAS_ADDEND)
+        acc_a = tl.fma(p, xa, acc_a)
+        acc_b = tl.fma(p, xb, acc_b)
+    acc_a = acc_a * inv_sum
+    acc_b = acc_b * inv_sum
+    out = Out + tl.program_id(0).to(tl.int64) * T * D + row_off
+    if APPLY_NORM:
+        sum_sq = tl.sum(acc_a * acc_a) + tl.sum(acc_b * acc_b)
+        out_rstd = rsqrt(tl.div_rn(sum_sq, D) + norm_eps)
+        wa = tl.load(NormW + q_off + da, mask_a, other=0).to(tl.float32)
+        wb = tl.load(NormW + q_off + db, mask_b, other=0).to(tl.float32)
+        acc_a = acc_a * out_rstd * wa
+        acc_b = acc_b * out_rstd * wb
+    tl.store(out + da, acc_a.to(Out.dtype.element_ty), mask_a)
+    tl.store(out + db, acc_b.to(Out.dtype.element_ty), mask_b)
+
+
+def attn_res(
+    stack: torch.Tensor,
+    last: torch.Tensor,
+    addend: torch.Tensor | None,
+    queries: torch.Tensor,
+    norm_weight: torch.Tensor | None,
+    norm_eps: float,
+    normalize_values: bool,
+    eps: float = 1e-6,
+) -> torch.Tensor:
+    """Mix `[*stack, last (+ addend)]` with each pseudo-query.
+
+    `queries` are fp32 `(Q, D)`, already scaled by `D**-0.5`; each fp32
+    mix is RMS-normalized with its row of `norm_weight` `(Q, D)`. Returns
+    `(Q, T, D)` in `last.dtype`, or the fp32 mixes without `norm_weight`.
+    """
+    num_tokens, d = last.shape
+    num_stack = stack.shape[0]
+    num_q = queries.shape[0]
+    assert last.is_contiguous() and queries.is_contiguous()
+    assert queries.dtype == torch.float32
+    assert stack.stride(1) == d and stack.stride(2) == 1
+    if addend is not None:
+        assert addend.is_contiguous() and addend.shape == last.shape
+    apply_norm = norm_weight is not None
+    if norm_weight is None:
+        norm_weight = queries  # unread
+    assert norm_weight.shape == queries.shape and norm_weight.is_contiguous()
+    out_dtype = last.dtype if apply_norm else torch.float32
+    out = torch.empty((num_q, num_tokens, d), dtype=out_dtype, device=last.device)
+    args = (
+        stack,
+        last,
+        addend,
+        queries,
+        norm_weight,
+        out,
+        stack.stride(0),
+        num_tokens,
+        eps,
+        norm_eps,
+    )
+    meta = dict(
+        D=d,
+        N_STACK=num_stack,
+        HAS_ADDEND=addend is not None,
+        NORMALIZE=normalize_values,
+        APPLY_NORM=apply_norm,
+        BLOCK_N=triton.next_power_of_2(num_stack + 1),
+        enable_fp_fusion=False,
+        launch_pdl=True,
+    )
+    # The queries of a token run back to back and share its sources in L2.
+    grid = (num_q, num_tokens)
+    if num_tokens * num_q <= 256:
+        block_a = triton.next_power_of_2(d + 1) // 2
+        block_b = max(triton.next_power_of_2(d - block_a), 16)
+        _attn_res_row_kernel[grid](
+            *args, **meta, BLOCK_A=block_a, BLOCK_B=block_b, num_warps=8
+        )
+    else:
+        _attn_res_kernel[grid](*args, **meta, BLOCK_D=1024, num_warps=4)
+    return out
