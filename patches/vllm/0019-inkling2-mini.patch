--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/sconv.py
@@ -0,0 +1,1016 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Inkling2 short convolution over a paged sliding-window conv-state cache.
+
+The cache (`[num_blocks, H, N, D]`, see `InklingConvState` in
+`vllm/models/inkling2/nvidia/sconv.py`) stores each stream's conv input at every
+absolute position. Per token, one launch writes the current input to its slot
+and convolves the `W` taps ending at its position: taps inside this forward
+are read from `x`, earlier taps from the paged cache, and taps before
+position 0 are zero.
+
+Static convolution (fp32 accumulate, oldest tap first)::
+
+    y = (sum_k w[c, k] * x[t - (W - 1) + k] + x[t]) * (W + 1) ** -0.5
+
+Dynamic convolution (newest tap first, per-token per-head tap weights)::
+
+    y = (sum_l (static_w[l, c] + dyn[t, head(c), l]) * x[t - l] + x[t])
+        * (2 * W + 1) ** -0.5
+
+`y` is rounded to the input dtype. The K/V variant then L2-clips K and
+RMS-normalizes V per head and writes both to the paged KV cache.
+"""
+
+import torch
+
+from vllm.models.inkling2.nvidia.ops.norm import qr_clip_rel_tokens, rsqrt
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _cached_taps(
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    c_mask,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    req,
+    src,
+    cached,
+):
+    safe_src = tl.maximum(src, 0)
+    lblk = tl.minimum(safe_src // N, max_blocks - 1)
+    blk = tl.load(block_table_ptr + req * stride_bt + lblk, mask=cached, other=0)
+    return tl.load(
+        cache_ptr
+        + blk.to(tl.int64)[:, None] * stride_c_blk
+        + (safe_src % N)[:, None] * stride_c_n
+        + cache_col[None, :],
+        mask=c_mask[None, :] & cached[:, None],
+        other=0.0,
+    ).to(tl.float32)
+
+
+@triton.jit
+def _cached_tap(
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    c_mask,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    req,
+    pos,
+    toff,
+    qstart,
+    valid,
+    lag: tl.constexpr,
+):
+    src = pos - lag
+    cached = valid & (src >= 0) & (toff - lag < qstart)
+    return _cached_taps(
+        cache_ptr,
+        cache_col,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        c_mask,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        req,
+        src,
+        cached,
+    )
+
+
+@triton.jit
+def _tap_sum(
+    x_ptr,
+    stride_x,
+    cache_ptr,
+    cache_col,
+    stride_c_blk,
+    stride_c_n,
+    N,
+    weight_ptr,
+    stride_w0,
+    stride_w1,
+    block_table_ptr,
+    stride_bt,
+    max_blocks,
+    toff,
+    coff,
+    c_mask,
+    tc_mask,
+    pos,
+    req,
+    qstart,
+    valid,
+    cur,
+    W: tl.constexpr,
+    dyn_ptr,
+    stride_dyn,
+    HEAD_DIM: tl.constexpr,
+    preloaded=None,
+    READ_CACHE: tl.constexpr = False,
+):
+    """Weighted sum of the W taps; earlier steps' taps come from
+    `preloaded` or, with READ_CACHE, from the cache (else they are zero)."""
+    dtype = cache_ptr.dtype.element_ty
+    acc = tl.zeros(cur.shape, dtype=tl.float32)
+    for k in tl.static_range(W):
+        lag = k if dyn_ptr is not None else W - 1 - k
+        src = pos - lag
+        row = toff - lag
+        in_win = valid & (src >= 0)
+        intra = in_win & (row >= qstart)
+        cached = in_win & (row < qstart)
+        xt = (
+            tl.load(
+                x_ptr + tl.maximum(row, 0)[:, None] * stride_x + coff[None, :],
+                mask=c_mask[None, :] & intra[:, None],
+                other=0.0,
+            )
+            .to(dtype)
+            .to(tl.float32)
+        )
+        if preloaded is not None:
+            xt += preloaded[k]
+        elif READ_CACHE:
+            xt += _cached_taps(
+                cache_ptr,
+                cache_col,
+                stride_c_blk,
+                stride_c_n,
+                N,
+                c_mask,
+                block_table_ptr,
+                stride_bt,
+                max_blocks,
+                req,
+                src,
+                cached,
+            )
+        value = xt
+        if dyn_ptr is not None:
+            w = tl.load(
+                weight_ptr + lag * stride_w0 + coff * stride_w1, mask=c_mask, other=0
+            ).to(tl.float32)
+            dyn = tl.load(
+                dyn_ptr
+                + toff[:, None] * stride_dyn
+                + (coff // HEAD_DIM)[None, :] * W
+                + lag,
+                mask=tc_mask,
+                other=0,
+            ).to(tl.float32)
+            w = w[None, :] + dyn
+        else:
+            w = tl.load(
+                weight_ptr + coff * stride_w0 + k * stride_w1, mask=c_mask, other=0
+            )
+            w = w.to(dtype).to(tl.float32)[None, :]
+        acc = value * w if dyn_ptr is not None and k == 0 else tl.fma(value, w, acc)
+    return acc
+
+
+@triton.jit
+def _conv(
+    x_ptr,  # [T, C] current-token inputs (also the residual)
+    stride_x,
+    cache_ptr,  # [num_blocks, H, N, D] paged conv-state cache
+    cache_col,  # [C] offset of each channel within a cache block row
+    stride_c_blk,
+    stride_c_n,
+    N,
+    weight_ptr,  # static: [C, W]; dynamic: [W, C]
+    stride_w0,
+    stride_w1,
+    pos_ptr,  # [T] absolute positions
+    seq_idx_ptr,  # [T] request of each token
+    slot_ptr,  # [T] flat cache slot (< 0: padding)
+    block_table_ptr,  # [num_reqs, max_blocks]
+    stride_bt,
+    max_blocks,
+    qstart_ptr,  # [T] first row of each token's request
+    scale,
+    toff,
+    coff,
+    t_mask,
+    c_mask,
+    W: tl.constexpr,
+    dyn_ptr=None,  # dynamic: [T, C // HEAD_DIM, W]
+    stride_dyn=0,
+    HEAD_DIM: tl.constexpr = 1,
+    SKIP_IDLE_CACHE: tl.constexpr = False,
+    CACHE_FIRST: tl.constexpr = False,
+    tile_reads_cache=True,
+):
+    """Store the current inputs to the cache; return `y` in fp32.
+
+    With `CACHE_FIRST` (static W=4 conv), the taps from earlier steps are
+    loaded before waiting on the producer of `x` (PDL).
+    """
+    tc_mask = t_mask[:, None] & c_mask[None, :]
+    slot = tl.load(slot_ptr + toff, mask=t_mask, other=-1)
+    valid = slot >= 0
+    pos = tl.load(pos_ptr + toff, mask=t_mask, other=0)
+    req = tl.load(seq_idx_ptr + toff, mask=t_mask, other=0)
+    qstart = tl.load(qstart_ptr + toff, mask=t_mask, other=0)
+    if CACHE_FIRST:
+        tl.static_assert(W == 4 and dyn_ptr is None)
+        taps = (
+            cache_ptr,
+            cache_col,
+            stride_c_blk,
+            stride_c_n,
+            N,
+            c_mask,
+            block_table_ptr,
+            stride_bt,
+            max_blocks,
+            req,
+            pos,
+            toff,
+            qstart,
+            valid,
+        )
+        cached0 = _cached_tap(*taps, 3)
+        cached1 = _cached_tap(*taps, 2)
+        cached2 = _cached_tap(*taps, 1)
+        cached3 = _cached_tap(*taps, 0)
+        tl.extra.cuda.gdc_wait()
+
+    dtype = cache_ptr.dtype.element_ty
+    cur = tl.load(x_ptr + toff[:, None] * stride_x + coff[None, :], mask=tc_mask)
+    cur = cur.to(dtype)
+    safe_slot = tl.maximum(slot, 0)
+    dst = (
+        cache_ptr
+        + (safe_slot // N)[:, None] * stride_c_blk
+        + (safe_slot % N)[:, None] * stride_c_n
+        + cache_col[None, :]
+    )
+    tl.store(dst, cur, mask=tc_mask & valid[:, None])
+
+    tap_args = (
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        cache_col,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        weight_ptr,
+        stride_w0,
+        stride_w1,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        toff,
+        coff,
+        c_mask,
+        tc_mask,
+        pos,
+        req,
+        qstart,
+        valid,
+        cur,
+    )
+    # Only tiles with a token among the first W - 1 of a request read taps
+    # from the cache; SKIP_IDLE_CACHE branches around the others' loads once.
+    if CACHE_FIRST:
+        preloaded = (cached0, cached1, cached2, cached3)
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM, preloaded)
+    elif not SKIP_IDLE_CACHE or tile_reads_cache:
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM, READ_CACHE=True)
+    else:
+        acc = _tap_sum(*tap_args, W, dyn_ptr, stride_dyn, HEAD_DIM)
+    return (acc + cur.to(tl.float32)) * scale
+
+
+@triton.jit
+def _sconv_kernel(
+    x_ptr,
+    cache_ptr,
+    weight_ptr,
+    out_ptr,  # [T, C]
+    res_ptr,  # [T, C] optional residual base, added before addend
+    addend_ptr,  # [T, C] optional
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_x,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_w0,
+    stride_w1,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    W: tl.constexpr,
+    OFF: tl.constexpr,
+    WS: tl.constexpr,
+    H: tl.constexpr,
+    HAS_RES: tl.constexpr,
+    HAS_ADDEND: tl.constexpr,
+    BT: tl.constexpr,
+    BLOCK_C: tl.constexpr,
+    SKIP_IDLE_CACHE: tl.constexpr,
+):
+    first = tl.program_id(0) * BT
+    tile_reads_cache = True
+    if SKIP_IDLE_CACHE:
+        tl.extra.cuda.gdc_wait()
+        # Request starts are non-decreasing: no token of the tile is among the
+        # first W - 1 of its request unless the last token's request starts
+        # after first - (W - 1).
+        last = tl.minimum(first + BT, T) - 1
+        tile_reads_cache = tl.load(qstart_ptr + last) > first - (W - 1)
+    toff = first + tl.arange(0, BT)
+    coff = tl.program_id(1) * BLOCK_C + tl.arange(0, BLOCK_C)
+    C = H * WS
+    t_mask = toff < T
+    c_mask = coff < C
+    y = _conv(
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        tl.minimum(coff // WS, H - 1) * stride_c_h + OFF + coff % WS,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        weight_ptr,
+        stride_w0,
+        stride_w1,
+        pos_ptr,
+        seq_idx_ptr,
+        slot_ptr,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        qstart_ptr,
+        scale,
+        toff,
+        coff,
+        t_mask,
+        c_mask,
+        W,
+        SKIP_IDLE_CACHE=SKIP_IDLE_CACHE,
+        CACHE_FIRST=not SKIP_IDLE_CACHE,
+        tile_reads_cache=tile_reads_cache,
+    ).to(out_ptr.dtype.element_ty)
+    offs = toff[:, None] * C + coff[None, :]
+    mask = t_mask[:, None] & c_mask[None, :]
+    if HAS_ADDEND:
+        # Residual update in the reference order: (res + addend) + y in fp32.
+        acc = tl.load(addend_ptr + offs, mask, other=0).to(tl.float32)
+        if HAS_RES:
+            acc = tl.load(res_ptr + offs, mask, other=0).to(tl.float32) + acc
+        y = (acc + y.to(tl.float32)).to(out_ptr.dtype.element_ty)
+    tl.store(out_ptr + offs, y, mask=mask)
+
+
+def short_conv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    cache: torch.Tensor,
+    positions: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_idx: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    query_start: torch.Tensor,
+    stream_offset: int,
+    stream_width: int,
+    addend: torch.Tensor | None = None,
+    residual: torch.Tensor | None = None,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Insert `x` (rounded to the cache dtype) into the conv-state cache and
+    return the static convolution with `(C, W)` taps `weight`.
+
+    With `addend`, returns `(residual + addend) + y` accumulated in fp32
+    (`residual` may alias `out`).
+    """
+    num_tokens, channels = x.shape
+    if out is None:
+        out = torch.empty((num_tokens, channels), dtype=cache.dtype, device=x.device)
+    assert x.stride(1) == 1 and cache.stride(3) == 1 and out.is_contiguous()
+    assert residual is None or addend is not None
+    for t in (addend, residual):
+        assert t is None or (t.is_contiguous() and t.shape == out.shape)
+    num_heads = cache.shape[1]
+    assert channels == num_heads * stream_width
+    width = weight.shape[1]
+    # Prefill tiles skip the cache reads they never need.
+    prefill = num_tokens > 256
+    if num_tokens <= 8:
+        block_t, block_c = 1, 1024
+    else:
+        block_t, block_c = (4, 256) if prefill else (2, 512)
+    block_c = min(triton.next_power_of_2(channels), block_c)
+    grid = (triton.cdiv(num_tokens, block_t), triton.cdiv(channels, block_c))
+    _sconv_kernel[grid](
+        x,
+        cache,
+        weight,
+        out,
+        residual,
+        addend,
+        positions,
+        seq_idx,
+        slot_mapping,
+        block_table,
+        query_start,
+        num_tokens,
+        x.stride(0),
+        cache.stride(0),
+        cache.stride(1),
+        cache.stride(2),
+        weight.stride(0),
+        weight.stride(1),
+        block_table.stride(0),
+        block_table.shape[1],
+        cache.shape[2],
+        (width + 1) ** -0.5,
+        W=width,
+        OFF=stream_offset,
+        WS=stream_width,
+        H=num_heads,
+        HAS_RES=residual is not None,
+        HAS_ADDEND=addend is not None,
+        BT=block_t,
+        BLOCK_C=block_c,
+        SKIP_IDLE_CACHE=prefill,
+        num_warps=4,
+        enable_fp_fusion=False,
+        launch_pdl=True,
+    )
+    return out
+
+
+# Columns of shift_rel_proj beyond the extent, 256 on either side.
+_SHIFT_PAD = 512
+
+
+def shift_rel_proj(rel_proj: torch.Tensor, is_local: bool) -> torch.Tensor:
+    """Return the `(8, d_rel + 1, extent + 512)` table `attention_prologue`
+    reads the `(d_rel, extent)` relative projection from, so that every
+    sheared output column block is an aligned slice of one of 8 shifts.
+
+    `out[s, :d_rel, y]` is `rel_proj[:, d]` for distance `d = s + extent
+    + 256 - y`, or zero out of range; row `d_rel` is the padding added to
+    the logits: -inf for negative distances and, if `is_local`, those past
+    the extent, else zero.
+    """
+    d_rel, extent = rel_proj.shape
+    shift = torch.arange(8, device=rel_proj.device)[:, None]
+    y = torch.arange(extent + _SHIFT_PAD, device=rel_proj.device)
+    dist = shift + extent + 256 - y
+    outside = (dist < 0) | (dist >= extent)
+    proj = rel_proj[:, dist.clamp(0, extent - 1)].transpose(0, 1)
+    pad = (dist >= extent) if is_local else torch.zeros_like(outside)
+    pad = (dist < 0) | pad
+    pad = torch.zeros_like(proj[:, :1]).masked_fill(pad[:, None], float("-inf"))
+    return torch.cat([proj.masked_fill(outside[:, None], 0), pad], 1).contiguous()
+
+
+@triton.jit
+def _attn_prologue_kernel(
+    k_ptr,  # [T, H * D] K projection
+    v_ptr,  # [T, H * D] V projection
+    wk_ptr,  # static: [H * D, W]; dynamic: [W, H * D]
+    wv_ptr,
+    dk_ptr,  # dynamic: [T, H, W] per-token K tap deltas
+    dv_ptr,
+    cache_ptr,
+    key_cache_ptr,  # [num_blocks, block_size, H, D]
+    value_cache_ptr,
+    kv_slot_ptr,  # [T] KV cache slot (< 0: skip)
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_k,
+    stride_v,
+    stride_w0,
+    stride_w1,
+    stride_dk,
+    stride_dv,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_kv_blk,
+    stride_kv_n,
+    stride_kv_h,
+    kv_block_size,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    clip_threshold,
+    clip_eps,
+    norm_eps,
+    q_ptr,  # [T, HQ, D] query projection (row-strided)
+    r_ptr,  # [T, HQ, D_REL] relative-query projection (row-strided)
+    q_scale_ptr,
+    r_scale_ptr,
+    tau_ptr,
+    rel_proj_ptr,
+    q_out_ptr,
+    rel_out_ptr,
+    cu_seqlens_q_ptr,
+    seq_lens_ptr,
+    stride_q,
+    stride_r,
+    rel_threshold,
+    W: tl.constexpr,
+    D: tl.constexpr,
+    DYNAMIC: tl.constexpr,
+    BT: tl.constexpr,
+    HQ: tl.constexpr,
+    D_REL: tl.constexpr,
+    E: tl.constexpr,
+    SHIFT_W: tl.constexpr,
+    HAS_TAU: tl.constexpr,
+    BLOCK_HQ: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+    QR_TOKENS: tl.constexpr,
+    FUSE_QR: tl.constexpr,
+):
+    tl.extra.cuda.gdc_wait()
+    # The decode attention kernel prefetches cached keys meanwhile.
+    tl.extra.cuda.gdc_launch_dependents()
+    # Programs (tile, head, 0 | 1) run the K | V conv of one KV head; programs
+    # (tile, head, 2) clip q of QR_TOKENS of the tile's tokens and programs
+    # (tile, head, 3 + c) their r and column block c of the relative logits.
+    if FUSE_QR and tl.program_id(2) >= 2:
+        if tl.program_id(1) * QR_TOKENS < BT:
+            qr_clip_rel_tokens(
+                tl.program_id(0) * BT + tl.program_id(1) * QR_TOKENS,
+                QR_TOKENS,
+                tl.program_id(2) - 3,
+                T,
+                q_ptr,
+                r_ptr,
+                q_scale_ptr,
+                r_scale_ptr,
+                tau_ptr,
+                rel_proj_ptr,
+                q_out_ptr,
+                rel_out_ptr,
+                seq_idx_ptr,
+                cu_seqlens_q_ptr,
+                seq_lens_ptr,
+                stride_q,
+                stride_r,
+                clip_threshold,
+                rel_threshold,
+                clip_eps,
+                HQ,
+                D,
+                D_REL,
+                E,
+                SHIFT_W,
+                HAS_TAU,
+                BLOCK_HQ,
+                BLOCK_E,
+            )
+    else:
+        _kv_conv_tile(
+            k_ptr,
+            v_ptr,
+            wk_ptr,
+            wv_ptr,
+            dk_ptr,
+            dv_ptr,
+            cache_ptr,
+            key_cache_ptr,
+            value_cache_ptr,
+            kv_slot_ptr,
+            pos_ptr,
+            seq_idx_ptr,
+            slot_ptr,
+            block_table_ptr,
+            qstart_ptr,
+            T,
+            stride_k,
+            stride_v,
+            stride_w0,
+            stride_w1,
+            stride_dk,
+            stride_dv,
+            stride_c_blk,
+            stride_c_h,
+            stride_c_n,
+            stride_kv_blk,
+            stride_kv_n,
+            stride_kv_h,
+            kv_block_size,
+            stride_bt,
+            max_blocks,
+            N,
+            scale,
+            clip_threshold,
+            clip_eps,
+            norm_eps,
+            W,
+            D,
+            DYNAMIC,
+            BT,
+        )
+
+
+@triton.jit
+def _qr_rel_kernel(
+    q_ptr,
+    r_ptr,
+    q_scale_ptr,
+    r_scale_ptr,
+    tau_ptr,
+    rel_proj_ptr,
+    q_out_ptr,
+    rel_out_ptr,
+    seq_idx_ptr,
+    cu_seqlens_q_ptr,
+    seq_lens_ptr,
+    T,
+    stride_q,
+    stride_r,
+    clip_threshold,
+    rel_threshold,
+    clip_eps,
+    HQ: tl.constexpr,
+    D: tl.constexpr,
+    D_REL: tl.constexpr,
+    E: tl.constexpr,
+    SHIFT_W: tl.constexpr,
+    HAS_TAU: tl.constexpr,
+    BLOCK_HQ: tl.constexpr,
+    BLOCK_E: tl.constexpr,
+    QR_TOKENS: tl.constexpr,
+):
+    # Runs alongside the K/V conv launch (`_attn_prologue_kernel` without
+    # FUSE_QR), which started it after its own grid dependency wait; waiting
+    # for that launch before exiting keeps the KV cache written for the
+    # attention that follows.
+    qr_clip_rel_tokens(
+        tl.program_id(0) * QR_TOKENS,
+        QR_TOKENS,
+        tl.program_id(1) - 1,
+        T,
+        q_ptr,
+        r_ptr,
+        q_scale_ptr,
+        r_scale_ptr,
+        tau_ptr,
+        rel_proj_ptr,
+        q_out_ptr,
+        rel_out_ptr,
+        seq_idx_ptr,
+        cu_seqlens_q_ptr,
+        seq_lens_ptr,
+        stride_q,
+        stride_r,
+        clip_threshold,
+        rel_threshold,
+        clip_eps,
+        HQ,
+        D,
+        D_REL,
+        E,
+        SHIFT_W,
+        HAS_TAU,
+        BLOCK_HQ,
+        BLOCK_E,
+    )
+    tl.extra.cuda.gdc_wait()
+
+
+@triton.jit
+def _kv_conv_tile(
+    k_ptr,
+    v_ptr,
+    wk_ptr,
+    wv_ptr,
+    dk_ptr,
+    dv_ptr,
+    cache_ptr,
+    key_cache_ptr,
+    value_cache_ptr,
+    kv_slot_ptr,
+    pos_ptr,
+    seq_idx_ptr,
+    slot_ptr,
+    block_table_ptr,
+    qstart_ptr,
+    T,
+    stride_k,
+    stride_v,
+    stride_w0,
+    stride_w1,
+    stride_dk,
+    stride_dv,
+    stride_c_blk,
+    stride_c_h,
+    stride_c_n,
+    stride_kv_blk,
+    stride_kv_n,
+    stride_kv_h,
+    kv_block_size,
+    stride_bt,
+    max_blocks,
+    N,
+    scale,
+    clip_threshold,
+    clip_eps,
+    norm_eps,
+    W: tl.constexpr,
+    D: tl.constexpr,
+    DYNAMIC: tl.constexpr,
+    BT: tl.constexpr,
+):
+    toff = tl.program_id(0) * BT + tl.arange(0, BT)
+    head = tl.program_id(1)
+    is_v = tl.program_id(2) == 1
+    d_idx = tl.arange(0, D)
+    coff = head * D + d_idx
+    t_mask = toff < T
+    if is_v:
+        x_ptr = v_ptr
+        w_ptr = wv_ptr
+        dyn_ptr = dv_ptr
+        stride_x = stride_v
+        stride_dyn = stride_dv
+    else:
+        x_ptr = k_ptr
+        w_ptr = wk_ptr
+        dyn_ptr = dk_ptr
+        stride_x = stride_k
+        stride_dyn = stride_dk
+    y = _conv(
+        x_ptr,
+        stride_x,
+        cache_ptr,
+        head * stride_c_h + tl.program_id(2) * D + d_idx,
+        stride_c_blk,
+        stride_c_n,
+        N,
+        w_ptr,
+        stride_w0,
+        stride_w1,
+        pos_ptr,
+        seq_idx_ptr,
+        slot_ptr,
+        block_table_ptr,
+        stride_bt,
+        max_blocks,
+        qstart_ptr,
+        scale,
+        toff,
+        coff,
+        t_mask,
+        d_idx < D,
+        W,
+        dyn_ptr if DYNAMIC else None,
+        stride_dyn,
+        D,
+    )
+    y = y.to(k_ptr.dtype.element_ty).to(tl.float32)
+    sum_sq = tl.sum(y * y, axis=1)
+    if is_v:
+        y = y * rsqrt(tl.div_rn(sum_sq, D) + norm_eps)[:, None]
+        cache = value_cache_ptr
+    else:
+        norm = tl.where(sum_sq > 0, sum_sq * rsqrt(sum_sq), 0.0)
+        y = y * tl.minimum(tl.div_rn(clip_threshold, norm + clip_eps), 1.0)[:, None]
+        cache = key_cache_ptr
+    kv_slot = tl.load(kv_slot_ptr + toff, mask=t_mask, other=-1)
+    safe = tl.maximum(kv_slot, 0)
+    dst = (
+        cache
+        + (safe // kv_block_size)[:, None] * stride_kv_blk
+        + (safe % kv_block_size)[:, None] * stride_kv_n
+        + head * stride_kv_h
+        + d_idx[None, :]
+    )
+    tl.store(dst, y.to(cache.dtype.element_ty), mask=(kv_slot >= 0)[:, None])
+
+
+# From this many tokens, q/r run in their own launch (8 tokens per program)
+# beside the K/V convs (8 per program): the fused launch's one-token q/r
+# programs dominate prefill.
+_PROLOGUE_SPLIT_MIN_TOKENS = 2048
+
+
+def _prologue_block_t(num_tokens: int) -> int:
+    return 8 if num_tokens >= _PROLOGUE_SPLIT_MIN_TOKENS else 4
+
+
+def _prologue_qr_tokens(num_tokens: int) -> int:
+    """Tokens per program of the separate q/r launch, or 0 to run q/r in the
+    K/V conv launch."""
+    return 8 if num_tokens >= _PROLOGUE_SPLIT_MIN_TOKENS else 0
+
+
+def attention_prologue(
+    q: torch.Tensor,
+    r: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    q_scale: torch.Tensor,
+    r_scale: torch.Tensor,
+    tau: torch.Tensor | None,
+    rel_proj: torch.Tensor,
+    k_weight: torch.Tensor,
+    v_weight: torch.Tensor,
+    k_dynamic: torch.Tensor | None,
+    v_dynamic: torch.Tensor | None,
+    cache: torch.Tensor,
+    positions: torch.Tensor,
+    block_table: torch.Tensor,
+    seq_idx: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    query_start: torch.Tensor,
+    key_cache: torch.Tensor,
+    value_cache: torch.Tensor,
+    kv_slot_mapping: torch.Tensor,
+    q_out: torch.Tensor,
+    rel_out: torch.Tensor,
+    cu_seqlens_q: torch.Tensor,
+    seq_lens: torch.Tensor,
+    *,
+    clip_threshold: float,
+    rel_threshold: float,
+    norm_eps: float,
+    clip_eps: float = 1e-6,
+) -> None:
+    """Attention input processing in one launch.
+
+    Writes the L2-clipped `q * q_scale` to `q_out` and the relative logits
+    of the clipped `r * r_scale` to `rel_out` (with `tau`, clipped values
+    are rounded, then scaled by the fp32 per-token `tau`). `rel_proj` is
+    the `shift_rel_proj` table; the logits come out sheared as tml_fa4 reads
+    them for a varlen launch over all tokens (`(T + 128, HQ, extent +
+    256)`) from the per-request `cu_seqlens_q` and `seq_lens`. Runs the
+    K/V short convolutions, clips K, RMS-normalizes V and inserts both into
+    the KV cache (tokens with `kv_slot_mapping < 0` skip the write).
+
+    `q` `(T, HQ, D)`, `r` `(T, HQ, D_rel)` and `k`/`v`
+    `(T, H * D)` may be row-strided; K and V occupy `[0, D)` and
+    `[D, 2 * D)` of each conv-state head. Conv weights are static
+    `(H * D, W)` taps, or with `(T, H * W)` per-token deltas
+    `k/v_dynamic` the `(W, H * D)` static part.
+    """
+    num_tokens = kv_slot_mapping.shape[0]
+    num_heads, head_dim = key_cache.shape[2:]
+    num_q_heads, d_rel = r.shape[1:]
+    extent = rel_proj.shape[2] - _SHIFT_PAD
+    assert rel_proj.shape[:2] == (8, d_rel + 1)
+    assert k.stride(1) == v.stride(1) == 1 and cache.stride(3) == 1
+    assert key_cache.stride() == value_cache.stride() and key_cache.stride(3) == 1
+    assert k_weight.stride() == v_weight.stride()
+    assert q.shape[1:] == (num_q_heads, head_dim)
+    assert q_out.shape == q.shape
+    assert rel_out.shape == (q.shape[0] + 128, num_q_heads, extent + 256)
+    assert q.stride(2) == 1 and q.stride(1) == head_dim
+    assert r.stride(2) == 1 and r.stride(1) == d_rel
+    assert q_out.is_contiguous() and rel_out.is_contiguous()
+    assert q_scale.is_contiguous() and r_scale.is_contiguous()
+    assert rel_proj.is_contiguous() and d_rel >= 16
+    block_e = min(extent, 256)
+    for size in (head_dim, d_rel, block_e):
+        assert size & (size - 1) == 0, "tile sizes must be powers of 2"
+    assert extent % block_e == 0
+    dynamic = k_dynamic is not None
+    if dynamic:
+        assert k_dynamic is not None and v_dynamic is not None
+        width = k_weight.shape[0]
+        assert k_dynamic.stride(1) == v_dynamic.stride(1) == 1
+        dyn_strides = (k_dynamic.stride(0), v_dynamic.stride(0))
+    else:
+        width = k_weight.shape[1]
+        dyn_strides = (0, 0)
+    block_t = _prologue_block_t(num_tokens)
+    qr_tokens = _prologue_qr_tokens(num_tokens)
+    qr_blocks = 1 + (extent + 256) // block_e
+    grid = (
+        triton.cdiv(num_tokens, block_t),
+        num_heads,
+        2 + (0 if qr_tokens else qr_blocks),
+    )
+    _attn_prologue_kernel[grid](
+        k,
+        v,
+        k_weight,
+        v_weight,
+        # Unused placeholders for static convs keep both branches typed alike.
+        k_dynamic if dynamic else k_weight,
+        v_dynamic if dynamic else v_weight,
+        cache,
+        key_cache,
+        value_cache,
+        kv_slot_mapping,
+        positions,
+        seq_idx,
+        slot_mapping,
+        block_table,
+        query_start,
+        num_tokens,
+        k.stride(0),
+        v.stride(0),
+        k_weight.stride(0),
+        k_weight.stride(1),
+        *dyn_strides,
+        cache.stride(0),
+        cache.stride(1),
+        cache.stride(2),
+        key_cache.stride(0),
+        key_cache.stride(1),
+        key_cache.stride(2),
+        key_cache.shape[1],
+        block_table.stride(0),
+        block_table.shape[1],
+        cache.shape[2],
+        (width * (2 if dynamic else 1) + 1) ** -0.5,
+        clip_threshold,
+        clip_eps,
+        norm_eps,
+        q,
+        r,
+        q_scale,
+        r_scale,
+        tau,
+        rel_proj,
+        q_out,
+        rel_out,
+        cu_seqlens_q,
+        seq_lens,
+        q.stride(0),
+        r.stride(0),
+        rel_threshold,
+        W=width,
+        D=head_dim,
+        DYNAMIC=dynamic,
+        BT=block_t,
+        HQ=num_q_heads,
+        D_REL=d_rel,
+        E=extent,
+        SHIFT_W=rel_proj.shape[2],
+        HAS_TAU=tau is not None,
+        BLOCK_HQ=max(triton.next_power_of_2(num_q_heads), 16),
+        BLOCK_E=block_e,
+        QR_TOKENS=triton.cdiv(block_t, num_heads),
+        FUSE_QR=not qr_tokens,
+        num_warps=4,
+        enable_fp_fusion=False,
+        launch_pdl=True,
+    )
+    if qr_tokens:
+        _qr_rel_kernel[(triton.cdiv(num_tokens, qr_tokens), qr_blocks)](
+            q,
+            r,
+            q_scale,
+            r_scale,
+            tau,
+            rel_proj,
+            q_out,
+            rel_out,
+            seq_idx,
+            cu_seqlens_q,
+            seq_lens,
+            num_tokens,
+            q.stride(0),
+            r.stride(0),
+            clip_threshold,
+            rel_threshold,
+            clip_eps,
+            HQ=num_q_heads,
+            D=head_dim,
+            D_REL=d_rel,
+            E=extent,
+            SHIFT_W=rel_proj.shape[2],
+            HAS_TAU=tau is not None,
+            BLOCK_HQ=max(triton.next_power_of_2(num_q_heads), 16),
+            BLOCK_E=block_e,
+            QR_TOKENS=qr_tokens,
+            num_warps=4,
+            enable_fp_fusion=False,
+            launch_pdl=True,
+        )
diff --git a/vllm/models/inkling2/nvidia/ops/seq_parallel.py b/vllm/models/inkling2/nvidia/ops/seq_parallel.py
new file mode 100644
index 0000000..c085cb5
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/seq_parallel.py
@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Sequence-parallel residual stream of large batches (TP > 1, CUDA).
+
+Each rank owns a contiguous token shard of the hidden stream. The attention
+partial sums (written straight into this rank's symmetric buffer) are
+reduce-scattered to the shard owners; the MoE combine pushes its partial rows
+straight into the owners' per-source slots instead. The owners run the short
+conv (on the slots' rank-order sum) and the AttnRes mix + RMSNorm on their
+shard only and push the normalized mix outputs into every rank's all-gather
+buffer.
+"""
+
+import torch
+import torch.distributed as dist
+
+# Barrier flag rows at the start of every symmetric buffer: one per
+# reduce-scatter CTA, then the all-gather's and the MoE push's.
+_MAX_CTAS = 1024
+_FLAG_BYTES = 64 * 1024
+_MAX_QUERIES = 3
+# The conv taps' halo rows before a shard.
+HALO_ROWS = 3
+
+
+class SeqParallel:
+    """Symmetric (MNNVL) buffers of up to `max_tokens` rows: the partial
+    sums (aliased by the per-source slots of pushed partial rows), the
+    `(3, max_tokens, hidden)` all-gather destination and the staging rows
+    of the conv-state cache.
+
+    Later steps read the conv-state cache rows of each request's last
+    `tail_rows` tokens (decode and verify rollbacks, the next chunk) and of
+    the tokens before prefix-cache hit boundaries; their owners push them to
+    every rank, which writes them to its cache.
+    """
+
+    def __init__(
+        self,
+        group: dist.ProcessGroup,
+        hidden_size: int,
+        max_tokens: int,
+        tail_rows: int,
+    ) -> None:
+        from flashinfer.comm.mnnvl import (
+            SymmDeviceMemory,
+            TorchDistBackend,
+            create_tensor_from_cuda_memory,
+        )
+
+        self.world_size = group.size()
+        self.rank = dist.get_rank(group)
+        # The smallest batches that run sequence parallel: below, the
+        # all-reduce of the full stream is faster end to end.
+        self.min_tokens = 2048 if self.world_size <= 4 else 1536
+        self.hidden_size = hidden_size
+        self.max_tokens = max_tokens
+        self.tail_rows = tail_rows
+        row_bytes = hidden_size * 2
+        # Each source rank's slot: the halo rows, then the shard's rows. A
+        # rank pushes into them (or overwrites its partial sums) only after
+        # the all-gather barrier of a later conv + mix, which every rank
+        # passes once done reading them.
+        self.slot_rows = -(-max_tokens // self.world_size) + HALO_ROWS
+        partial_rows = max(max_tokens, self.world_size * self.slot_rows)
+        self.partial_offset = _FLAG_BYTES
+        self.gather_offset = self.partial_offset + partial_rows * row_bytes
+        self.staging_offset = self.gather_offset + _MAX_QUERIES * max_tokens * row_bytes
+        size = self.staging_offset + max_tokens * row_bytes
+        device = torch.accelerator.current_device_index()
+        self.memory = SymmDeviceMemory(
+            size,
+            self.world_size,
+            self.rank,
+            device,
+            TorchDistBackend(group=group),
+            enable_multicast=False,
+            allocate_signal_pads=False,
+        )
+        self.buffer = create_tensor_from_cuda_memory(
+            self.memory.uc_ptrs[self.rank], (size,), torch.uint8, device
+        )
+        self.buffer[:_FLAG_BYTES].zero_()
+        self.bases = self.memory.uc_ptrs_dev
+        # Every rank's buffer, starting with this rank's (push order).
+        ptrs = self.memory.uc_ptrs
+        self.push_bases = torch.tensor(
+            ptrs[self.rank :] + ptrs[: self.rank], dtype=torch.int64, device=device
+        )
+        # This rank's slot in every rank's buffer.
+        self.slot_bases = torch.tensor(
+            [
+                ptr + self.partial_offset + self.rank * self.slot_rows * row_bytes
+                for ptr in ptrs
+            ],
+            dtype=torch.int64,
+            device=device,
+        )
+        num_sms = torch.cuda.get_device_properties(device).multi_processor_count
+        # One reduce-scatter CTA per SM: more only add barrier traffic.
+        self.epochs = torch.zeros(num_sms, dtype=torch.int32, device=device)
+        self.gather_slot = _MAX_CTAS
+        # The all-gather barrier's epoch, finished-CTA count and released
+        # epoch.
+        self.gather_epochs = torch.zeros(3, dtype=torch.int32, device=device)
+        torch.accelerator.synchronize()
+        dist.barrier(group)
+
+    def _view(self, offset: int, shape: tuple[int, ...]) -> torch.Tensor:
+        numel = 1
+        for s in shape:
+            numel *= s
+        return self.buffer[offset : offset + 2 * numel].view(torch.bfloat16).view(shape)
+
+    def shard(self, num_tokens: int) -> tuple[int, int, int]:
+        """This rank's tokens `[begin, end)` and the shard capacity."""
+        size = -(-num_tokens // self.world_size)
+        begin = min(self.rank * size, num_tokens)
+        return begin, min(begin + size, num_tokens), size
+
+    def partial(self, num_tokens: int) -> torch.Tensor:
+        """Where this rank writes its `(T, hidden)` partial sums."""
+        assert num_tokens <= self.max_tokens
+        return self._view(self.partial_offset, (num_tokens, self.hidden_size))
+
+    def gathered(self, num_queries: int, num_tokens: int) -> torch.Tensor:
+        return self._view(
+            self.gather_offset, (_MAX_QUERIES, self.max_tokens, self.hidden_size)
+        )[:num_queries, :num_tokens]
+
+    def reduce_scatter(self, num_tokens: int) -> tuple[torch.Tensor, int]:
+        """The reduced rows of this rank's shard, preceded by the conv taps'
+        halo rows (and their count)."""
+        begin, end, _ = self.shard(num_tokens)
+        halo = min(begin, 3)
+        out = torch.empty(
+            (end - begin + halo, self.hidden_size),
+            dtype=torch.bfloat16,
+            device=self.epochs.device,
+        )
+        torch.ops._C.inkling2_reduce_scatter(
+            self.bases,
+            self.epochs,
+            self.rank,
+            self.world_size,
+            self.partial_offset,
+            begin - halo,
+            out,
+        )
+        return out, halo
+
+    def pushed(self, num_tokens: int) -> tuple[torch.Tensor, int]:
+        """The `(world, halo + shard, hidden)` partial rows of this rank's
+        shard every rank pushed (`ops.moe.combine_push`), and the halo count."""
+        begin, end, _ = self.shard(num_tokens)
+        halo = min(begin, HALO_ROWS)
+        slots = self._view(
+            self.partial_offset, (self.world_size, self.slot_rows, self.hidden_size)
+        )
+        return slots[:, HALO_ROWS - halo : HALO_ROWS + end - begin], halo
diff --git a/vllm/models/inkling2/nvidia/ops/trtllm_bmm.cu b/vllm/models/inkling2/nvidia/ops/trtllm_bmm.cu
new file mode 100644
index 0000000..6573ee3
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/trtllm_bmm.cu
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: Apache-2.0
+// SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+//
+// Standalone TRT-LLM-gen batched expert GEMM (FlashInfer cubins): block-scaled
+// NVFP4 / MXFP8 weights x expert-sorted, tile-padded activations -> bf16, with
+// an optional fp32 per-row output scale. Built by FlashInfer's JIT and linked
+// against FlashInfer's TRT-LLM-gen MoE module, which holds the runner.
+
+#include <tvm/ffi/container/array.h>
+#include <tvm_ffi_utils.h>
+
+#include <map>
+#include <memory>
+
+#include "flashinfer/trtllm/batched_gemm/KernelRunner.h"
+
+namespace inkling2 {
+
+using tensorrt_llm::kernels::TrtllmGenBatchedGemmRunner;
+using tensorrt_llm::kernels::TrtllmGenBatchedGemmRunnerOptions;
+using tvm::ffi::Array;
+using tvm::ffi::Optional;
+namespace btg = batchedGemm::trtllm::gen;
+
+namespace {
+
+TrtllmGenBatchedGemmRunner& getRunner(bool nvfp4, int64_t tileN) {
+  static std::map<std::pair<bool, int64_t>,
+                  std::unique_ptr<TrtllmGenBatchedGemmRunner>>
+      runners;
+  auto& runner = runners[{nvfp4, tileN}];
+  if (!runner) {
+    auto const dtype = nvfp4 ? btg::Dtype::E2m1 : btg::Dtype::MxE4m3;
+    TrtllmGenBatchedGemmRunnerOptions options{};
+    options.dtypeA = dtype;
+    options.dtypeB = dtype;
+    options.dtypeC = btg::Dtype::Bfloat16;
+    options.transposeMmaOutput = true;
+    options.tileSize = static_cast<int32_t>(tileN);
+    options.epilogueTileM = 128;
+    options.useShuffledMatrix = true;
+    options.usePerTokenScaling = nvfp4;
+    options.perTokenSfDtype = nvfp4 ? btg::Dtype::Fp32 : btg::Dtype::Void;
+    runner = std::make_unique<TrtllmGenBatchedGemmRunner>(options);
+  }
+  return *runner;
+}
+
+}  // namespace
+
+// Indices of the configs of a (format, token tile) runner and their B scale
+// layouts.
+Array<int64_t> bmm_configs(bool nvfp4, int64_t tile_n) {
+  auto& runner = getRunner(nvfp4, tile_n);
+  Array<int64_t> configs;
+  for (int64_t index : runner.getPassingConfigIndices()) {
+    configs.push_back(index);
+    configs.push_back(static_cast<int64_t>(runner.getSfLayoutB(index)));
+  }
+  return configs;
+}
+
+// Whether config ``index`` runs [num_experts, n, k] weights with up to
+// ``max_ctas`` token tiles, and the workspace bytes it needs (-1: invalid).
+int64_t bmm_workspace_size(bool nvfp4, int64_t tile_n, int64_t index, int64_t n,
+                           int64_t k, int64_t num_experts, int64_t max_ctas) {
+  auto& runner = getRunner(nvfp4, tile_n);
+  int32_t const tokens = static_cast<int32_t>(max_ctas * tile_n);
+  if (!runner.isValidConfigIndex(index, tokens, n, k, {}, tokens, num_experts,
+                                 max_ctas)) {
+    return -1;
+  }
+  return runner.getWorkspaceSizeInBytes(tokens, n, k, {}, tokens, num_experts,
+                                        max_ctas, index);
+}
+
+// out[r] = bf16((act[r] @ weight[e(r)]^T) * row_scale[r]), where row r of the
+// tile-padded activations belongs to expert cta_to_expert[r / tile_n].
+void bmm_run(bool nvfp4, int64_t tile_n, int64_t index, TensorView weight,
+             TensorView weight_scale, TensorView act, TensorView act_scale,
+             Optional<TensorView> row_scale, TensorView ones, TensorView out,
+             TensorView cta_to_expert, TensorView cta_row_limit,
+             TensorView num_ctas, TensorView num_padded_rows,
+             int64_t max_ctas) {
+  int32_t const num_experts = weight.size(0);
+  int32_t const n = weight.size(1);
+  int32_t const k = act.size(1) * (nvfp4 ? 2 : 1);
+  int32_t const tokens = static_cast<int32_t>(max_ctas * tile_n);
+  TVM_FFI_ICHECK(act.size(0) >= tokens && out.size(0) >= tokens &&
+                 out.size(1) == n);
+  getRunner(nvfp4, tile_n)
+      .run(tokens, n, k, {}, tokens, num_experts,
+           static_cast<int32_t>(max_ctas), act.data_ptr(), act_scale.data_ptr(),
+           weight.data_ptr(), weight_scale.data_ptr(),
+           row_scale.has_value() ? row_scale.value().data_ptr() : nullptr,
+           /*perTokensSfB=*/nullptr, static_cast<float const*>(ones.data_ptr()),
+           /*scaleGateC=*/nullptr, /*bias=*/nullptr, /*alpha=*/nullptr,
+           /*beta=*/nullptr,
+           /*clampLimit=*/nullptr, out.data_ptr(), /*outSfC=*/nullptr,
+           /*routeMap=*/nullptr,
+           static_cast<int32_t const*>(num_padded_rows.data_ptr()),
+           static_cast<int32_t const*>(cta_to_expert.data_ptr()),
+           static_cast<int32_t const*>(cta_row_limit.data_ptr()),
+           static_cast<int32_t const*>(num_ctas.data_ptr()),
+           /*permutedIdxToBiasRowIdx=*/nullptr,
+           /*workspace=*/nullptr, get_stream(act.device()),
+           act.device().device_id, index, /*enable_pdl=*/true);
+}
+
+}  // namespace inkling2
+
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(bmm_configs, inkling2::bmm_configs);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(bmm_workspace_size, inkling2::bmm_workspace_size);
+TVM_FFI_DLL_EXPORT_TYPED_FUNC(bmm_run, inkling2::bmm_run);
diff --git a/vllm/models/inkling2/nvidia/ops/trtllm_bmm.py b/vllm/models/inkling2/nvidia/ops/trtllm_bmm.py
new file mode 100644
index 0000000..92af3b3
--- /dev/null
+++ b/vllm/models/inkling2/nvidia/ops/trtllm_bmm.py
@@ -0,0 +1,235 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TRT-LLM-gen batched expert GEMMs (FlashInfer cubins) for the Inkling2 MoE.
+
+The GEMMs read expert-sorted activation rows whose expert segments are padded
+to the token tile, with block scales in the R8c4 (tile < 128) or R128c4 layout
+(`block_scales`), and row-shuffled expert weights. Outputs are bf16; NVFP4
+outputs are scaled by an fp32 factor per row.
+"""
+
+import functools
+import math
+import os
+from dataclasses import dataclass
+
+import regex as re
+import torch
+
+from . import use_sm100_kernels
+
+_SOURCE = os.path.join(os.path.dirname(__file__), "trtllm_bmm.cu")
+
+# The GEMMs' TMA accesses can reach the first 128 KiB of an operand however
+# few of its rows are used (Blackwell's 128 KiB OOB address generation), so,
+# as in FlashInfer's MoE launchers (`maybeGetMinTokenCount`), every operand
+# and output is backed by at least that much memory.
+MIN_OPERAND_BYTES = 128 * 1024
+
+
+def operand(
+    rows: int, *shape: int, dtype: torch.dtype, device: torch.device
+) -> torch.Tensor:
+    """`torch.empty((rows, *shape))`, allocated with enough rows to span
+    `MIN_OPERAND_BYTES`."""
+    row_bytes = math.prod(shape) * dtype.itemsize
+    alloc_rows = max(rows, -(-MIN_OPERAND_BYTES // row_bytes))
+    return torch.empty((alloc_rows, *shape), dtype=dtype, device=device)[:rows]
+
+
+@functools.cache
+def _module():
+    from flashinfer.fused_moe.core import get_trtllm_moe_sm100_module
+    from flashinfer.jit.core import current_compilation_context, gen_jit_spec
+    from flashinfer.jit.fused_moe import gen_trtllm_gen_fused_moe_sm100_module
+
+    # Loads FlashInfer's MoE module (and its cubin loader), whose batched GEMM
+    # runner this module calls into.
+    get_trtllm_moe_sm100_module()
+    moe = gen_trtllm_gen_fused_moe_sm100_module()
+    flags = [f for f in moe.extra_cuda_cflags if f.startswith(("-DTLLM", "-DENABLE"))]
+    spec = gen_jit_spec(
+        "inkling2_trtllm_bmm",
+        [_SOURCE],
+        extra_cuda_cflags=flags
+        + current_compilation_context.get_nvcc_flags_list(
+            supported_major_versions=[10]
+        ),
+        extra_ldflags=[str(moe.get_library_path())],
+        extra_include_paths=moe.extra_include_dirs,
+    )
+    return spec.build_and_load(), moe.extra_include_dirs[0]
+
+
+@functools.cache
+def _config_names(include_dir) -> list[str]:
+    # The kernel manifest FlashInfer's MoE module is built from.
+    with open(include_dir / "flashinferMetaInfo.h") as f:
+        return re.findall(r'^\{nullptr, \d+, \d+, "(\w+)"', f.read(), re.M)
+
+
+@functools.cache
+def configs(nvfp4: bool, tile_n: int) -> dict[str, tuple[int, int]]:
+    """Kernel name -> (config index, B scale layout) of the (format, token
+    tile) GEMMs."""
+    module, include_dir = _module()
+    names = _config_names(include_dir)
+    flat = list(module.bmm_configs(nvfp4, tile_n))
+    return {names[i]: (i, layout) for i, layout in zip(flat[::2], flat[1::2])}
+
+
+# Token tile by batch size (tokens up to the first entry): tiles above the
+# mean rows per expert pay off once the routing is skewed.
+_TILES = ((8, 8), (128, 16), (384, 32), (768, 64), (4096, 128), (1 << 31, 256))
+# Kernel of each (format, tile) for the gate/up and down projections.
+_KERNELS = {
+    (True, 8): ("t128x8x512_s5_et128x8_m128x8x64_c1x1x1_rM_TN_transOut_schPd",) * 2,
+    (True, 16): ("t128x16x512_s5_et128x16_m256x16x64_c2x1x1_rM_TN_transOut_schPd",) * 2,
+    (True, 32): ("t128x32x512_s5_et128x32_m256x32x64_c2x1x1_rM_TN_transOut_schPd",) * 2,
+    (True, 64): ("t128x64x512_s4_et128x64_m256x64x64_c2x1x1_rM_TN_transOut_schPd",) * 2,
+    (True, 128): (
+        "t128x128x256u2_s6_et128x128_m256x128x64_c2x1x1_rM_TN_transOut_schPd",
+        "t128x128x256_s6_et128x128_m256x128x64_c2x1x1_rM_TN_transOut_schPd",
+    ),
+    (True, 256): ("t128x256x256_s5x5x5x5x1x1_et128x64_m256x256x64_c2x1x1",) * 2,
+    (False, 8): ("t128x8x512_s3_et128x8_m128x8x32_c1x1x1_rM_TN_transOut_schPd",) * 2,
+    (False, 16): (
+        "t128x16x256u2_s6_et128x16_m256x16x32_c2x1x1_rM_TN_transOut_schPd",
+        "t128x16x256_s6_et128x16_m256x16x32_c2x1x1_rM_TN_transOut_schPd",
+    ),
+    (False, 32): ("t128x32x256_s5_et128x32_m256x32x32_c2x1x1_rM_TN_transOut_schPd",)
+    * 2,
+    (False, 64): (
+        "t128x64x256u2_s4_et128x64_m256x64x32_c2x1x1_rM_TN_transOut_schPd",
+        "t128x64x256_s4_et128x64_m256x64x32_c2x1x1_rM_TN_transOut_schPd",
+    ),
+    (False, 128): (
+        "t128x128x256u2_s4_et128x64_m256x128x32_c2x1x1_rM_TN_transOut_schPd",
+        "t128x128x256_s4_et128x64_m256x128x32_c2x1x1_rM_TN_transOut_schPd",
+    ),
+    (False, 256): ("t128x256x128_s5x5x5x5x1x1_et128x64_m256x256x32_c2x1x1",) * 2,
+}
+
+
+@dataclass(frozen=True)
+class ExpertPlan:
+    """Token tile, launched tiles (an upper bound) and the kernel of each
+    projection for a batch."""
+
+    tile: int
+    max_ctas: int
+    kernels: tuple[int, int]
+
+    @property
+    def rows(self) -> int:
+        return self.tile * self.max_ctas
+
+
+@functools.cache
+def expert_plan(
+    tokens: int,
+    topk: int,
+    num_experts: int,
+    nvfp4: bool,
+    shapes: tuple[tuple[int, int], tuple[int, int]],
+    tile: int | None = None,
+) -> ExpertPlan:
+    """Plan for `tokens` routed to `topk` of all experts, `num_experts`
+    of them local, with (N, K) weight `shapes` of the two projections."""
+    if tile is None:
+        tile = next(t for max_tokens, t in _TILES if tokens <= max_tokens)
+    # Tiles if the local rows fill as many experts as possible, then pile up.
+    rows = tokens * topk
+    max_ctas = min(num_experts, rows) + (rows - min(num_experts, rows)) // tile
+    if not use_sm100_kernels():
+        # No TRT-LLM-gen kernels (Hopper): only `route`'s layout.
+        return ExpertPlan(tile, max_ctas, (0, 0))
+    names = configs(nvfp4, tile)
+    keys = _KERNELS[(nvfp4, tile)]
+    kernels = []
+    for projection, (n, k) in enumerate(shapes):
+        # The projection's kernel, else the other's (an unrolled K loop, say,
+        # needs K to be a multiple of its double K tile).
+        for key in (keys[projection], keys[1 - projection]):
+            ((index, layout),) = (v for name, v in names.items() if key in name)
+            assert layout == (3 if tile >= 128 else 1)  # R128c4 / R8c4 activations
+            size = _module()[0].bmm_workspace_size(
+                nvfp4, tile, index, n, k, num_experts, max_ctas
+            )
+            if size == 0:
+                kernels.append(index)
+                break
+        else:
+            raise AssertionError(f"no Inkling2 expert GEMM for {(n, k)}, tile {tile}")
+    return ExpertPlan(tile, max_ctas, (kernels[0], kernels[1]))
+
+
+def load_kernels(
+    weights: tuple[torch.Tensor, torch.Tensor],
+    weight_scales: tuple[torch.Tensor, torch.Tensor],
+    topk: int,
+) -> None:
+    """Loads the kernels of every batch size's plan by running them on no
+    tiles: loading is not allowed while a CUDA graph is captured."""
+    nvfp4 = weights[0].dtype == torch.uint8
+    num_experts = weights[0].shape[0]
+    pack = 2 if nvfp4 else 1
+    shapes = tuple((w.shape[1], w.shape[2] * pack) for w in weights)
+    device = weights[0].device
+    ones = torch.ones(num_experts, dtype=torch.float32, device=device)
+    for _, tile in _TILES:
+        plan = expert_plan(1, topk, num_experts, nvfp4, shapes, tile)
+        tiles = torch.zeros(2 * plan.max_ctas + 2, dtype=torch.int32, device=device)
+        for projection, (weight, scale) in enumerate(zip(weights, weight_scales)):
+            k = weight.shape[2]
+            act = operand(plan.rows, k, dtype=weight.dtype, device=device)
+            act_scale = operand(
+                plan.rows, scale.shape[2], dtype=scale.dtype, device=device
+            )
+            row_scale = (
+                operand(plan.rows, dtype=torch.float32, device=device)
+                if nvfp4
+                else None
+            )
+            bmm(act, act_scale, row_scale, weight, scale, ones, tiles, plan, projection)
+
+
+def bmm(
+    act: torch.Tensor,
+    act_scale: torch.Tensor,
+    row_scale: torch.Tensor | None,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    ones: torch.Tensor,
+    tiles: torch.Tensor,
+    plan: ExpertPlan,
+    projection: int,
+) -> torch.Tensor:
+    """bf16 `[plan.rows, N]` expert GEMM of the tile-padded `act` rows.
+
+    `tiles` holds the expert and row limit of each of the `plan.max_ctas`
+    tiles, then the number of tiles and of padded rows. `ones` (one per
+    expert) is the GEMM's output scale.
+    """
+    nvfp4 = weight.dtype == torch.uint8
+    n = weight.shape[1]
+    out = operand(plan.rows, n, dtype=torch.bfloat16, device=act.device)
+    m = plan.max_ctas
+    _module()[0].bmm_run(
+        nvfp4,
+        plan.tile,
+        plan.kernels[projection],
+        weight,
+        weight_scale,
+        act,
+        act_scale,
+        row_scale,
+        ones,
+        out,
+        tiles[:m],
+        tiles[m : 2 * m],
+        tiles[2 * m : 2 * m + 1],
+        tiles[2 * m + 1 :],
+        m,
+    )
+    return out
